<%@ page pageEncoding="UTF-8" %>
<div class="support-widget" data-support-widget data-user="${currentUserId}">
 <section id="support-widget-panel" class="support-widget-panel" role="dialog" aria-labelledby="support-widget-title" hidden>
  <header><div><span class="support-widget-mark" aria-hidden="true">✳</span><div><h2 id="support-widget-title">UTETra hỗ trợ</h2><p>Trò chuyện trực tiếp với admin</p></div></div><button type="button" data-chat-close aria-label="Thu nhỏ trò chuyện">−</button></header>
  <p class="support-widget-intro">Chào bạn! Hãy gửi câu hỏi, chúng mình sẽ phản hồi tại đây.</p>
  <button type="button" data-chat-older class="support-widget-older" hidden>Xem tin nhắn trước</button>
  <div class="support-widget-messages" role="log" aria-label="Tin nhắn hỗ trợ" aria-live="polite"></div>
  <p class="support-widget-status" role="status" aria-live="polite"></p>
  <form class="support-widget-compose"><label class="visually-hidden" for="support-widget-body">Tin nhắn gửi admin</label><textarea id="support-widget-body" maxlength="2000" rows="2" placeholder="Nhập tin nhắn của bạn…" required></textarea><button type="submit" aria-label="Gửi tin nhắn">Gửi ↗</button></form>
 </section>
 <button type="button" class="support-widget-launcher" aria-controls="support-widget-panel" aria-expanded="false"><svg class="icon" aria-hidden="true"><use href="#i-chat"/></svg><span>Chat với UTETra</span><span class="support-widget-unread" hidden>Tin mới</span></button>
</div>
