<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Chăm sóc khách hàng · UTETra</title><link rel="stylesheet" href="<c:url value='/assets/css/support.css'/>"></head><body>
<section id="support-app" class="support-page" data-user="${supportUserId}" data-customer="${supportCustomer}">
<div class="page-heading"><div><span class="eyebrow">UTETRA / CHĂM SÓC KHÁCH HÀNG</span><h1>Chúng mình lắng nghe.</h1><p>${supportCustomer ? 'Trao đổi trực tiếp với quản lý chi nhánh hoặc đội ngũ Admin UTETra.' : 'Tiếp nhận và hỗ trợ khách hàng trong phạm vi phụ trách của bạn.'}</p></div></div>
<p class="small text-secondary">Chỉ trao đổi khách hàng – nhân viên hỗ trợ. Không có chat giữa các Admin hoặc quản lý chi nhánh.</p>
<div id="support-alert" class="alert alert-warning" role="status" aria-live="polite" hidden></div>
<c:if test="${supportCustomer}"><form id="support-start" class="support-start card card-body mb-4"><label for="support-target" class="form-label">Bạn cần hỗ trợ từ đâu?</label><div class="d-flex flex-wrap gap-2"><select id="support-target" class="form-select" required><option value="">Đang tải kênh hỗ trợ…</option></select><button class="btn btn-primary">Bắt đầu trò chuyện</button></div></form></c:if>
<div class="support-workspace"><aside class="support-inbox card" aria-label="Hộp thư hỗ trợ"><div class="support-inbox-head"><h2 class="h5 mb-0">Hội thoại</h2><button id="support-refresh" class="btn btn-sm btn-outline-success" type="button">Tải lại</button></div><div id="support-threads" aria-live="polite"></div><nav class="support-paging" aria-label="Phân trang hội thoại"><button id="support-prev" class="btn btn-sm btn-outline-success" type="button" disabled>Trước</button><span id="support-page">Trang 1</span><button id="support-next" class="btn btn-sm btn-outline-success" type="button" disabled>Sau</button></nav></aside>
<section class="support-chat card" aria-label="Tin nhắn"><header class="support-chat-head"><h2 id="support-title" class="h5">Chọn một hội thoại</h2><p id="support-context" class="small text-secondary mb-0">Nội dung được lưu để bạn tiếp tục trao đổi khi quay lại.</p></header><button id="support-older" class="btn btn-link" type="button" hidden>Tải tin nhắn trước</button><div id="support-messages" class="support-messages" role="log" aria-label="Lịch sử trò chuyện" aria-live="polite"><p class="support-empty">Chọn hội thoại bên trái để xem lịch sử.</p></div>
<form id="support-compose" class="support-compose"><label for="support-body" class="form-label">Tin nhắn</label><textarea id="support-body" class="form-control" placeholder="Nhập điều bạn cần hỗ trợ…" rows="3" maxlength="4000" required disabled></textarea><div class="support-compose-actions"><small class="text-secondary">Tối đa 2000 ký tự. Không gửi mật khẩu hoặc mã OTP.</small><button class="btn btn-primary" disabled>Gửi tin nhắn</button></div><p id="support-connection" class="small text-secondary mb-0" role="status">Đang kết nối…</p></form></section></div></section>
<script src="<c:url value='/assets/js/support.js'/>" defer></script></body></html>
