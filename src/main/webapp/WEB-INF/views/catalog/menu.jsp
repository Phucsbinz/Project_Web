<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Thực đơn · UTETra</title></head><body>
<c:if test="${not empty groupToken}"><div class="alert alert-success d-flex flex-wrap justify-content-between gap-2"><strong>Bạn đang chọn món cho đơn nhóm</strong><a href="<c:url value='/group-orders/${groupToken}'/>">Về nhóm và xem phần của tôi →</a></div></c:if>
<div class="page-heading"><div><span class="eyebrow">UTETRA / THỰC ĐƠN</span><h1>Hôm nay, bạn uống gì?</h1><p>Tìm vị trà yêu thích và tùy chỉnh theo gu của bạn.</p></div><span class="page-number" aria-hidden="true">✳</span></div>
<section id="menu-section"><div class="section-heading"><div><div class="section-kicker">FIND YOUR EVERYDAY FAVORITE</div><h2>Thực đơn nhà UTETra</h2><p>Những lựa chọn cho một khoảng nghỉ thật ngon.</p></div></div>
<nav class="category-chips mb-3" aria-label="Khám phá Top 20"><a class="category-chip ${param.top == 'true' && param.sort == 'newest' ? 'active' : ''}" href="<c:url value='/menu'/>?top=true&amp;sort=newest">20 món mới nhất</a><a class="category-chip ${param.top == 'true' && param.sort == 'sold' ? 'active' : ''}" href="<c:url value='/menu'/>?top=true&amp;sort=sold">20 món bán chạy</a><a class="category-chip ${param.top == 'true' && param.sort == 'rating' ? 'active' : ''}" href="<c:url value='/menu'/>?top=true&amp;sort=rating">20 món đánh giá cao</a><a class="category-chip ${param.top == 'true' && param.sort == 'favorites' ? 'active' : ''}" href="<c:url value='/menu'/>?top=true&amp;sort=favorites">20 món được yêu thích</a></nav>
<div class="menu-toolbar"><nav class="category-chips" aria-label="Danh mục sản phẩm"><a class="category-chip ${empty param.categoryId ? 'active' : ''}" href="<c:url value='/menu'/>"><svg class="icon" aria-hidden="true"><use href="#i-grid"/></svg>Tất cả thức uống</a><c:forEach items="${categories}" var="category"><c:url value="/menu" var="categoryUrl"><c:param name="categoryId" value="${category.id}"/></c:url><a class="category-chip ${param.categoryId == category.id ? 'active' : ''}" href="${categoryUrl}"><c:out value="${category.name}"/></a></c:forEach></nav></div>
<div class="catalog-browser ${empty groupToken ? "catalog-with-cart" : "catalog-home"}"><form class="row g-3 catalog-filters" method="get" action="<c:url value='/menu'/>"><c:if test="${not empty groupToken}"><input type="hidden" name="group" value="<c:out value='${groupToken}'/>"></c:if>
<c:if test="${param.top == 'true'}"><input type="hidden" name="top" value="true"></c:if>
<div class="col-12 col-md-6 col-lg-3"><label class="form-label" for="keyword">BẠN ĐANG TÌM MÓN GÌ?</label><input class="form-control" id="keyword" name="keyword" placeholder="Tên món bạn yêu thích…" maxlength="150" value="<c:out value='${param.keyword}'/>"></div>
<div class="col-6 col-lg-3"><label class="form-label" for="categoryId">DANH MỤC</label><select class="form-select" id="categoryId" name="categoryId"><option value="">Tất cả danh mục</option><c:forEach items="${categories}" var="category"><option value="${category.id}" ${param.categoryId == category.id ? 'selected' : ''}><c:out value="${category.name}"/></option></c:forEach></select></div>

<div class="col-12"><label class="form-label" for="storeId">CHI NHÁNH</label><select class="form-select" id="storeId" name="storeId"><option value="">Tất cả chi nhánh</option><c:forEach items="${stores}" var="branch"><option value="${branch.id}" ${param.storeId == branch.id ? 'selected' : ''}><c:out value="${branch.name}"/></option></c:forEach></select></div>
<div class="col-12 col-md-6 col-lg-3"><label class="form-label" for="sort">SẮP XẾP THEO</label><select class="form-select" id="sort" name="sort"><c:forTokens items="newest,price_asc,price_desc,sold,rating,favorites" delims="," var="s"><option value="${s}" ${param.sort == s ? 'selected' : ''}><c:choose><c:when test="${s == 'newest'}">Mới nhất</c:when><c:when test="${s == 'price_asc'}">Giá tăng dần</c:when><c:when test="${s == 'price_desc'}">Giá giảm dần</c:when><c:when test="${s == 'sold'}">Bán chạy</c:when><c:when test="${s == 'rating'}">Đánh giá cao</c:when><c:otherwise>Yêu thích nhiều</c:otherwise></c:choose></option></c:forTokens></select></div>
<div class="col-6 col-md-4"><label class="form-label" for="min">GIÁ TỪ (Đ)</label><input class="form-control" type="number" min="0" id="min" name="min" placeholder="Không giới hạn" value="<c:out value='${param.min}'/>"></div><div class="col-6 col-md-4"><label class="form-label" for="max">ĐẾN (Đ)</label><input class="form-control" type="number" min="0" id="max" name="max" placeholder="Không giới hạn" value="<c:out value='${param.max}'/>"></div><div class="col-12 col-md-4 d-flex align-items-end"><button class="btn btn-primary w-100"><svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>Tìm ly trà của bạn</button></div></form><div class="catalog-results">
<%@ include file="product-list.jspf" %>
<nav class="catalog-pagination" aria-label="Phân trang"><c:if test="${result.page > 0}"><button type="button" class="btn btn-outline-dark catalog-page" data-page="${result.page - 1}">← Trang trước</button></c:if><span>Trang ${result.page + 1} · ${result.total} món</span><c:if test="${result.page + 1 < result.pages}"><button type="button" class="btn btn-outline-dark catalog-page" data-page="${result.page + 1}">Trang sau →</button></c:if></nav>
</div><c:if test="${empty groupToken}"></c:if></div></section>
<%@ include file="drink-modal.jspf" %><script src="<c:url value='/assets/js/catalog.js'/>" defer></script></body></html>
