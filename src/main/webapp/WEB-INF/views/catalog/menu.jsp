<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Thực đơn · UTETra</title></head><body>
<c:choose><c:when test="${currentPath == '/'}"><section class="tea-hero" aria-label="Chào mừng đến UTETra"><div class="hero-copy"><div class="hero-kicker">THE UTETRA TEA RITUAL</div><h1>Một chút trà.<br>Một ngày <em>thảnh thơi.</em></h1><p>Gác lại vội vàng, tìm một vị trà hợp gu.<br>Niềm vui đôi khi chỉ cần một chiếc ống hút.</p><div class="hero-actions"><a class="btn btn-light" href="#menu-section">Khám phá thực đơn <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a><a class="btn hero-secondary" href="<c:url value='/stores'/>">Chọn cửa hàng</a></div><div class="hero-bottom"><span aria-hidden="true">✳</span><span>PHA MỘT CHÚT VUI CHO NGÀY CỦA BẠN</span></div></div><div class="hero-visual"><img src="<c:url value='/assets/images/utetra-tea-ritual.webp'/>" alt="Cảm hứng UTETra: trà sữa trân châu, matcha và trà trái cây trong ánh nắng ấm" fetchpriority="high" width="1536" height="1024"><div class="hero-orbit" aria-hidden="true">SIP SLOW<br>FEEL GOOD<br>✳</div><div class="hero-visual-label"><span>Your little tea break</span>Một chiếc hẹn với chính mình.</div></div></section>
<div class="ritual-strip"><div class="ritual-item"><span class="ritual-icon"><svg class="icon" aria-hidden="true"><use href="#i-store"/></svg></span><div><strong>Chọn nơi bạn yêu thích</strong><p>Tự chọn cửa hàng trước khi đặt món.</p></div></div><div class="ritual-item"><span class="ritual-icon"><svg class="icon" aria-hidden="true"><use href="#i-leaf"/></svg></span><div><strong>Mỗi ly, một cá tính</strong><p>Size, đường, đá &amp; topping theo ý bạn.</p></div></div><div class="ritual-item"><span class="ritual-icon"><svg class="icon" aria-hidden="true"><use href="#i-heart"/></svg></span><div><strong>Niềm vui có tích lũy</strong><p>Tích điểm từ đơn đã giao và thanh toán.</p></div></div></div></c:when><c:otherwise><div class="page-heading"><div><span class="eyebrow">UTETRA / THỰC ĐƠN</span><h1>Hôm nay, bạn uống gì?</h1><p>Tìm vị trà yêu thích, chọn cửa hàng và tạo một ly thật hợp gu.</p></div><span class="page-number" aria-hidden="true">✳</span></div></c:otherwise></c:choose>
<section id="menu-section"><div class="section-heading"><div><div class="section-kicker">FIND YOUR EVERYDAY FAVORITE</div><h2>Thực đơn nhà UTETra</h2><p>Những lựa chọn cho một khoảng nghỉ thật ngon.</p></div><a class="text-link" href="<c:url value='/stores'/>">Tìm cửa hàng <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
<div class="menu-toolbar"><nav class="category-chips" aria-label="Danh mục sản phẩm"><a class="category-chip ${empty param.categoryId ? 'active' : ''}" href="<c:url value='/menu'/>"><svg class="icon" aria-hidden="true"><use href="#i-grid"/></svg>Tất cả thức uống</a><c:forEach items="${categories}" var="category"><c:url value="/menu" var="categoryUrl"><c:param name="categoryId" value="${category.id}"/></c:url><a class="category-chip ${param.categoryId == category.id ? 'active' : ''}" href="${categoryUrl}"><c:out value="${category.name}"/></a></c:forEach></nav></div>
<form class="row g-3 catalog-filters" method="get" action="<c:url value='/menu'/>">
<div class="col-12 col-md-6 col-lg-3"><label class="form-label" for="keyword">BẠN ĐANG TÌM MÓN GÌ?</label><input class="form-control" id="keyword" name="keyword" placeholder="Tên món bạn yêu thích…" maxlength="150" value="<c:out value='${param.keyword}'/>"></div>
<div class="col-6 col-lg-3"><label class="form-label" for="categoryId">DANH MỤC</label><select class="form-select" id="categoryId" name="categoryId"><option value="">Tất cả danh mục</option><c:forEach items="${categories}" var="category"><option value="${category.id}" ${param.categoryId == category.id ? 'selected' : ''}><c:out value="${category.name}"/></option></c:forEach></select></div>
<div class="col-6 col-lg-3"><label class="form-label" for="storeId">CỬA HÀNG</label><select class="form-select" id="storeId" name="storeId"><option value="">Tất cả cửa hàng</option><c:forEach items="${stores}" var="s"><option value="${s.id}" ${param.storeId == s.id ? 'selected' : ''}><c:out value="${s.name}"/></option></c:forEach></select></div>
<div class="col-12 col-md-6 col-lg-3"><label class="form-label" for="sort">SẮP XẾP THEO</label><select class="form-select" id="sort" name="sort"><c:forTokens items="newest,price_asc,price_desc,sold,rating,favorites" delims="," var="s"><option value="${s}" ${param.sort == s ? 'selected' : ''}><c:choose><c:when test="${s == 'newest'}">Mới nhất</c:when><c:when test="${s == 'price_asc'}">Giá tăng dần</c:when><c:when test="${s == 'price_desc'}">Giá giảm dần</c:when><c:when test="${s == 'sold'}">Bán chạy</c:when><c:when test="${s == 'rating'}">Đánh giá cao</c:when><c:otherwise>Yêu thích nhiều</c:otherwise></c:choose></option></c:forTokens></select></div>
<div class="col-6 col-md-4"><label class="form-label" for="min">GIÁ TỪ (Đ)</label><input class="form-control" type="number" min="0" id="min" name="min" placeholder="Không giới hạn" value="<c:out value='${param.min}'/>"></div><div class="col-6 col-md-4"><label class="form-label" for="max">ĐẾN (Đ)</label><input class="form-control" type="number" min="0" id="max" name="max" placeholder="Không giới hạn" value="<c:out value='${param.max}'/>"></div><div class="col-12 col-md-4 d-flex align-items-end"><button class="btn btn-primary w-100"><svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>Tìm ly trà của bạn</button></div></form>
<c:if test="${currentPath == '/' && empty groups}"><p class="no-results">Các món bán trên 10 ly, xếp theo số lượng đã giao và thanh toán.</p></c:if>
<%@ include file="product-list.jspf" %>
<nav class="catalog-pagination" aria-label="Phân trang"><c:if test="${result.page > 0}"><button type="button" class="btn btn-outline-dark catalog-page" data-page="${result.page - 1}">← Trang trước</button></c:if><span>Trang ${result.page + 1} · ${result.total} món</span><c:if test="${result.page + 1 < result.pages}"><button type="button" class="btn btn-outline-dark catalog-page" data-page="${result.page + 1}">Trang sau →</button></c:if></nav>
<c:forEach items="${groups}" var="group"><section class="catalog-group"><div class="section-heading"><h2><c:choose><c:when test="${group.key == 'newest'}">20 món mới nhất</c:when><c:when test="${group.key == 'sold'}">20 món bán chạy</c:when><c:when test="${group.key == 'rating'}">20 món đánh giá cao</c:when><c:otherwise>20 món được yêu thích</c:otherwise></c:choose></h2><a class="text-link" href="<c:url value='/menu'/>?top=true&amp;sort=${group.key}">Xem tất cả ↗</a></div><c:set var="result" value="${group.value}"/><%@ include file="product-list.jspf" %></section></c:forEach></section>
<c:if test="${currentPath == '/'}"><section class="brand-story"><div class="story-art"><img src="<c:url value='/assets/images/utetra-tea-ritual.webp'/>" alt="Khoảng nghỉ cùng hương vị trà tại UTETra" loading="lazy" width="1536" height="1024"></div><div class="story-copy"><span class="section-kicker">A LITTLE MOMENT FOR YOURSELF</span><h2>Gu trà của bạn.<br><em>Niềm vui của chúng mình.</em></h2><p>Không có công thức nào cho một ngày hoàn hảo. Nhưng một ly trà đúng vị luôn là khởi đầu dễ thương.</p><p>Chọn một cửa hàng, thêm topping yêu thích và để UTETra cùng bạn tạo nên khoảng nghỉ nhỏ trong ngày.</p><a class="text-link" href="<c:url value='/stores'/>">Ghé một cửa hàng UTETra <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div></section></c:if>
<script src="<c:url value='/assets/js/catalog.js'/>" defer></script></body></html>