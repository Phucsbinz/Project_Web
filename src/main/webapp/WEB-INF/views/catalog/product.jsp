<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title><c:out value="${product.name}"/> · UTETra</title><c:if test="${param.quick == '1'}"><style>.announcement,.site-header,.site-footer,.skip-link{display:none!important}.page-main{padding:0!important;max-width:none!important}.product-detail{border:0!important;border-radius:0!important;padding:24px!important}.product-info h1{font-size:25px!important}#product-community{margin:0 24px 24px!important}body{background:#fffef9!important}</style></c:if></head><body>

<div class="product-detail"><div class="product-gallery"><c:choose><c:when test="${not empty product.imageUrl}"><img class="w-100" src="<c:out value='${product.imageUrl}'/>" alt="<c:out value='${product.name}'/>"></c:when><c:otherwise><div class="catalog-placeholder"><svg class="icon" aria-hidden="true"><use href="#i-leaf"/></svg><span>UTETRA</span></div></c:otherwise></c:choose></div><div class="product-info">
<span class="section-kicker">YOUR CUP, YOUR WAY</span><h1><c:out value="${product.name}"/></h1><p class="product-description"><c:out value="${product.description}"/></p><p class="product-price fs-3"><small>Từ</small><span data-money="${product.basePrice}">${product.basePrice} đ</span></p>
<p class="small text-secondary">Chọn món theo ý thích. Chi nhánh phục vụ sẽ được chọn khi lên đơn.</p><form id="drink-form" data-group="<c:out value='${groupToken}'/>" data-base-price="${product.basePrice}" data-product="${product.id}" class="vstack gap-3 mt-3"><div><label class="form-label" for="variantId">Size</label><select class="form-select" name="variantId" id="variantId" required><c:forEach items="${product.variants}" var="v"><c:if test="${v.active}"><option value="${v.id}" data-extra-price="${v.extraPrice}">${v.sizeName} (+${v.extraPrice} đ)</option></c:if></c:forEach></select></div>
<div class="row"><c:forTokens items="sugarLevel,iceLevel" delims="," var="field"><div class="col"><label class="form-label" for="${field}">${field == 'sugarLevel' ? 'Đường' : 'Đá'}</label><select class="form-select" name="${field}" id="${field}"><c:forTokens items="0,30,50,70,100" delims="," var="level"><option value="${level}" ${level == '100' ? 'selected' : ''}>${level}%</option></c:forTokens></select></div></c:forTokens></div>
<fieldset><legend class="fs-6">Topping (một phần mỗi loại / ly)</legend><c:forEach items="${product.toppings}" var="t"><label class="form-check"><input class="form-check-input" type="checkbox" name="toppingIds" value="${t.id}" data-price="${t.price}"><span class="form-check-label"><c:out value="${t.name}"/> (+${t.price} đ)</span></label></c:forEach><c:if test="${empty product.toppings}"><p class="small text-secondary">Chưa có topping sẵn bán cho món này.</p></c:if></fieldset>
<div><label class="form-label" for="quantity">Số lượng</label><input class="form-control" name="quantity" id="quantity" type="number" min="1" max="20" value="1" required></div><button class="btn btn-dark" type="submit" data-product-submit data-available="${product.available}" disabled>${not empty groupToken ? 'Thêm vào nhóm' : 'Thêm vào giỏ hàng'}</button><output id="quote-result" class="alert alert-light border" aria-live="polite">Chọn size, đường, đá và số lượng để đặt món.</output></form>
<c:choose><c:when test="${not empty groupToken}"><a class="btn btn-outline-success mt-3" href="<c:url value='/group-orders/${groupToken}'/>">Về đơn nhóm</a></c:when><c:otherwise><a class="btn btn-outline-success mt-3" href="<c:url value='/cart'/>">Xem giỏ hàng</a></c:otherwise></c:choose></div></div><section id="product-community" class="mt-5" data-product="${product.id}" data-buyer="${currentRole == 'ROLE_USER' || currentRole == 'ROLE_VENDOR'}">
<h2 class="h4">Khách hàng chia sẻ</h2><p role="status" aria-live="polite">Đang tải đánh giá…</p>
<div class="d-flex flex-wrap gap-2 mb-4"><button type="button" class="btn btn-outline-success" data-favorite>Lưu yêu thích</button><a class="btn btn-outline-success" href="<c:url value='/reviews'/>">Đánh giá món đã mua</a><a class="btn btn-outline-success" href="<c:url value='/comments'/>">Viết bình luận</a></div>
<h3 class="h5">Đánh giá</h3><div data-list="reviews"></div><h3 class="h5 mt-4">Bình luận</h3><div data-list="comments"></div>
</section><script src="<c:url value='/assets/js/product-community.js'/>" defer></script><script src="<c:url value='/assets/js/catalog.js'/>" defer></script></body></html>
