<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Quản lý bán hàng · UTETra</title><link rel="stylesheet" href="<c:url value='/assets/css/catalog-management.css'/>"></head><body>
<div id="catalog-manager" data-role="${rolePath}" data-section="${catalogSection}"><span class="eyebrow">KHÔNG GIAN QUẢN LÝ</span><h1 id="management-title">Quản lý bán hàng</h1><p id="management-guide">Chọn chức năng và chi nhánh để bắt đầu.</p>
<c:if test="${rolePath == 'admin' && currentPath == '/admin'}"><section class="admin-shortcuts" aria-label="Truy cập nhanh"><a href="<c:url value='/admin/orders'/>"><strong>Đơn hàng</strong><span>Xác nhận, theo dõi và xử lý đơn →</span></a><a href="<c:url value='/admin/users'/>"><strong>Tài khoản &amp; quyền</strong><span>Tìm người dùng, cập nhật vai trò →</span></a><a href="<c:url value='/admin/reports'/>"><strong>Báo cáo</strong><span>Xem doanh thu và xuất dữ liệu →</span></a><a href="<c:url value='/admin/support'/>"><strong>Hỗ trợ khách hàng</strong><span>Đọc và phản hồi hội thoại →</span></a></section></c:if>
<nav id="catalog-tabs" class="d-flex flex-wrap gap-2 mb-4" aria-label="Chức năng quản lý"></nav>
<div class="catalog-scope-picker d-flex flex-wrap gap-3 align-items-center mb-4"><label for="managed-store" class="form-label mb-0">Chi nhánh đang quản lý</label><select id="managed-store" class="form-select" style="max-width:420px" aria-label="Shop quản lý"></select><button id="catalog-reload" type="button" class="btn btn-outline-dark">Làm mới dữ liệu</button></div>
<div id="management-message" role="status" aria-live="polite" class="mb-3"></div>
<div class="management-toolbar"><label for="management-search">Tìm trong danh sách<input id="management-search" type="search" class="form-control" placeholder="Nhập tên để tìm…" autocomplete="off"></label><button id="management-create" type="button" class="btn btn-primary">+ Thêm mới</button><span id="management-result-count" class="small text-secondary" role="status"></span></div><div class="catalog-workspace"><section class="catalog-records"><h2 id="catalog-list-title" class="h4">Danh sách</h2><div id="management-list" class="vstack gap-3"></div></section>
<section id="management-editor" class="card p-4"><h2 id="catalog-form-title" class="h4">Tạo mới</h2><form id="management-form" class="vstack gap-3"></form></section></div>
<section id="image-panel" class="card p-4 mt-4" hidden><h2 class="h5">Ảnh sản phẩm / chi nhánh</h2><form id="catalog-image" class="d-flex gap-3 flex-wrap align-items-end"><div><label for="image-type" class="form-label">Vị trí</label><select id="image-type" class="form-select"><option value="product">Ảnh sản phẩm</option><option value="store">Ảnh shop</option><option value="banner">Banner shop</option></select></div><div><label for="image-file" class="form-label">Ảnh JPEG/PNG, tối đa 5 MB</label><input class="form-control" id="image-file" type="file" accept="image/jpeg,image/png" required></div><button class="btn btn-outline-dark">Tải ảnh cho mục đang sửa</button></form></section>
</div><script src="<c:url value='/assets/js/catalog-management.js'/>" defer></script></body></html>
