<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Chọn shop · UTETra</title></head><body><h1>Chọn shop của bạn</h1><p>Chọn chi nhánh thủ công để xem thực đơn và khu vực giao hàng.</p><div class="row g-4"><c:forEach items="${stores}" var="s"><div class="col-md-6"><article class="card h-100"><div class="card-body"><h2 class="h4"><c:out value="${s.name}"/></h2><p><c:out value="${s.address}"/></p><p>${s.openTime} – ${s.closeTime} · <c:out value="${s.phone}"/></p><span class="badge ${s.acceptingOrders ? 'text-bg-success' : 'text-bg-secondary'}">${s.acceptingOrders ? 'Đang nhận đơn' : 'Tạm ngừng nhận đơn'}</span></div><div class="card-footer"><a class="btn btn-dark" href="<c:url value='/stores/${s.id}'/>">Xem shop và thực đơn</a></div></article></div></c:forEach></div><c:if test="${empty stores}"><p class="alert alert-light border">Chưa có shop đang hoạt động.</p></c:if></body></html>
