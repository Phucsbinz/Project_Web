<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="vi"><head><title>UTETra · Một chút matcha, một ngày thật khác</title>
<link rel="stylesheet" href="<c:url value='/assets/css/catalog-home.css?v=top20-two-rows-20261028'/>">
</head><body>
<div class="catalog-homepage">
  <section class="matcha-hero" aria-labelledby="home-title">
    <div class="matcha-copy">
      <span class="home-eyebrow"><span aria-hidden="true">✳</span> YOUR DAILY DOSE OF GREEN</span>
      <h1 id="home-title">Một chút matcha.<br>Một ngày <em>thật khác.</em></h1>
      <p>Vị trà đậm, lớp kem êm. Tìm ly trà hợp gu và dành cho mình một khoảng nghỉ thật ngon.</p>
      <div class="hero-actions"><a class="btn btn-primary" href="#home-drinks">Khám phá thực đơn <span aria-hidden="true">→</span></a><a class="btn btn-primary" href="<c:url value='/menu'/>">Đặt đơn</a><a class="btn btn-primary" href="<c:url value='/group-orders/new'/>">Đặt đơn nhóm</a></div>
      <div class="hero-details"><span><svg class="icon" aria-hidden="true"><use href="#i-leaf"/></svg> Chọn vị bạn thích</span><span>Size · Đường · Đá · Topping</span></div>
    </div>
    <div class="matcha-visual"><img src="<c:url value='/assets/images/menu/matcha-cheese.png'/>" alt="Ly matcha xanh cùng lớp kem phô mai UTETra" fetchpriority="high" width="1024" height="1024"><span class="matcha-stamp" aria-hidden="true">a little tea,<br><em>a little joy.</em><span>UTETra ✳</span></span><div class="matcha-caption"><span>MATCHA MOMENT</span><strong>Đậm vị trà. Êm vị kem.</strong></div></div>
  </section>
  <c:if test="${not empty categories}"><nav class="home-categories" aria-label="Danh mục đồ uống"><div class="category-intro"><span class="home-eyebrow">FIND YOUR FLAVOR</span><h2>Gu của bạn<br>là gì?</h2></div><div class="category-track"><c:forEach items="${categories}" var="category"><c:url value="/menu" var="homeCategoryUrl"><c:param name="categoryId" value="${category.id}"/></c:url><a class="home-category" href="${homeCategoryUrl}"><span class="category-art"><c:choose><c:when test="${not empty category.imageUrl}"><img src="<c:out value='${category.imageUrl}'/>" alt="" width="80" height="80" loading="lazy"></c:when><c:otherwise><svg class="icon" aria-hidden="true"><use href="#i-leaf"/></svg></c:otherwise></c:choose></span><span><c:out value="${category.name}"/></span><span aria-hidden="true">↗</span></a></c:forEach></div></nav></c:if>
  <section class="home-highlights home-section" id="home-drinks" aria-labelledby="highlights-title">
    <div class="home-heading"><div><span class="home-eyebrow">SIP. SMILE. REPEAT.</span><h2 id="highlights-title">Tìm thấy ly yêu thích.</h2></div><a class="text-link" href="<c:url value='/menu'/>">Xem thực đơn <span aria-hidden="true">↗</span></a></div>
    <div class="home-tabs" role="tablist" aria-label="Khám phá đồ uống"><button class="active" id="bestseller-tab" data-bs-toggle="tab" data-bs-target="#home-bestsellers" type="button" role="tab" aria-controls="home-bestsellers" aria-selected="true">Bán chạy <span aria-hidden="true">✳</span></button><button id="new-tab" data-bs-toggle="tab" data-bs-target="#home-new" type="button" role="tab" aria-controls="home-new" aria-selected="false">Món mới nhất <span aria-hidden="true">↗</span></button></div>
    <div class="tab-content"><div class="tab-pane show active" id="home-bestsellers" role="tabpanel" aria-labelledby="bestseller-tab" tabindex="0"><c:set var="homeCards" value="true"/><c:set var="carouselId" value="bestseller-track"/><c:set var="carouselLabel" value="Top 20 món bán chạy"/><%@ include file="home-product-carousel.jspf" %></div><div class="tab-pane" id="home-new" role="tabpanel" aria-labelledby="new-tab" tabindex="0"><c:set var="result" value="${newProducts}"/><c:set var="carouselId" value="newest-track"/><c:set var="carouselLabel" value="Top 20 món mới nhất"/><%@ include file="home-product-carousel.jspf" %><c:set var="homeCards" value="false"/></div></div>
    <p class="home-selection-note">Chọn món để tùy chỉnh trước khi thêm vào giỏ.</p>
  </section>

  <section class="home-offers home-section" aria-labelledby="offers-title"><div class="offer-intro"><span class="home-eyebrow">A LITTLE EXTRA JOY</span><h2 id="offers-title">Thêm chút vui.<br><em>Thêm ưu đãi.</em></h2><p>Khám phá ưu đãi theo chi nhánh. Điều kiện và mức giảm được kiểm tra khi thanh toán.</p><a class="text-link" href="<c:url value='/stores'/>">Khám phá ưu đãi tại cửa hàng ↗</a></div><div class="offer-list"><c:choose><c:when test="${not empty homePromotions}"><span class="offer-store">Tại <c:out value="${promotionStore.name}"/></span><c:forEach items="${homePromotions}" var="promo"><article class="home-voucher"><span class="voucher-symbol" aria-hidden="true">✳</span><div><h3><c:out value="${promo.name}"/></h3><p>Giảm ${promo.percent}% ${promo.kind == 'SHIPPING_PERCENT' ? 'phí giao hàng' : 'giá trị món áp dụng'} · Tối đa <span data-money="${promo.maxDiscount}">${promo.maxDiscount} đ</span></p><small>Đơn từ <span data-money="${promo.minOrder}">${promo.minOrder} đ</span><c:if test="${not empty promo.code}"> · Mã <strong><c:out value="${promo.code}"/></strong></c:if></small><a href="<c:url value='/stores/${promotionStore.id}'/>">Xem điều kiện tại chi nhánh →</a></div></article></c:forEach></c:when><c:otherwise><div class="offer-empty"><svg class="icon" aria-hidden="true"><use href="#i-heart"/></svg><h3>Điều ngọt ngào đang chờ.</h3><p>Chưa có ưu đãi đang áp dụng<c:if test="${not empty promotionStore}"> tại <c:out value="${promotionStore.name}"/></c:if>. Bạn có thể xem thêm tại các chi nhánh.</p><a class="btn btn-outline-dark" href="<c:url value='/stores'/>">Xem các chi nhánh ↗</a></div></c:otherwise></c:choose></div></section>
  <section class="home-story home-section" aria-labelledby="story-title"><div class="story-photo"><img src="<c:url value='/assets/images/utetra-tea-ritual-branded.png'/>" alt="Những ly trà UTETra trong một khoảng nghỉ nhẹ nhàng" width="1024" height="1024" loading="lazy"></div><div class="story-text"><span class="home-eyebrow">THE UTETRA WAY</span><h2 id="story-title">Không chỉ một ly trà.<br><em>Một chút thảnh thơi.</em></h2><p>UTETra dành một góc nhỏ cho những người yêu trà. Từ matcha dịu đậm đến trà sữa béo êm hay trà trái cây tươi vị, mỗi lựa chọn đều có thể mang dấu ấn của bạn.</p><div class="story-values"><span><b>01</b> Chọn vị yêu thích</span><span><b>02</b> Pha theo gu riêng</span><span><b>03</b> Gặp nhau ở UTETra</span></div><a class="text-link" href="<c:url value='/menu'/>">Tìm ly trà của bạn ↗</a></div></section>
  <section class="home-branches home-section" id="home-branches" aria-labelledby="branches-title"><div class="home-heading"><div><span class="home-eyebrow">YOUR NEIGHBORHOOD TEA SPOT</span><h2 id="branches-title">Một điểm hẹn. <em>Nhiều niềm vui.</em></h2></div><a class="text-link" href="<c:url value='/stores'/>">Tất cả cửa hàng ↗</a></div>
    <c:choose><c:when test="${not empty stores}"><form class="home-branch-picker" action="<c:url value='/menu'/>" method="get"><div><label for="home-store">Khám phá thực đơn theo chi nhánh</label><p>Chi nhánh phục vụ đơn hàng được xác nhận khi thanh toán.</p></div><select class="form-select" id="home-store" name="storeId" required><c:forEach items="${stores}" var="branch"><option value="${branch.id}"><c:out value="${branch.name}"/>${not branch.acceptingOrders ? ' · Tạm ngừng nhận đơn' : ''}</option></c:forEach></select><button class="btn btn-primary" type="submit">Xem thực đơn ↗</button></form><div class="home-branch-grid"><c:forEach items="${stores}" var="branch" end="2"><article class="home-branch"><div class="branch-top"><svg class="icon" aria-hidden="true"><use href="#i-store"/></svg><span class="branch-status ${branch.acceptingOrders ? 'accepting' : ''}">${branch.acceptingOrders ? 'Đang nhận đơn' : 'Tạm ngừng nhận đơn'}</span></div><h3><c:out value="${branch.name}"/></h3><p><c:out value="${branch.address}"/></p><small>${branch.openTime} – ${branch.closeTime}</small><a class="text-link" href="<c:url value='/stores/${branch.id}'/>">Thông tin &amp; ưu đãi ↗</a></article></c:forEach></div></c:when><c:otherwise><p class="home-empty">Chưa có chi nhánh đang hoạt động. Hẹn bạn quay lại sau.</p></c:otherwise></c:choose>
  </section>
</div>
<%@ include file="drink-modal.jspf" %>
<script src="<c:url value='/assets/js/catalog.js'/>" defer></script>
<script src="<c:url value='/assets/js/catalog-home.js?v=20261028'/>" defer></script>
</body></html>
