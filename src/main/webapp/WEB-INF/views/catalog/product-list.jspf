<%@ page pageEncoding="UTF-8" %>
<div class="row g-4">
<c:forEach items="${result.items}" var="p"><div class="col-12 col-sm-6 col-lg-3"><article class="card h-100 shadow-sm">
<c:choose><c:when test="${not empty p.imageUrl}"><img class="card-img-top catalog-photo" src="<c:out value='${p.imageUrl}'/>" alt="<c:out value='${p.name}'/>" loading="lazy"></c:when><c:otherwise><div class="catalog-placeholder" aria-hidden="true">UTETra</div></c:otherwise></c:choose>
<div class="card-body"><h3 class="h5"><c:out value="${p.name}"/></h3><p class="fw-bold">Từ ${p.basePrice} đ</p><p class="small text-secondary">Đã bán ${p.soldUnits} · ${p.rating} ★ · ${p.favorites} yêu thích</p><c:if test="${not p.available}"><span class="badge text-bg-secondary">Tạm hết món</span></c:if></div>
<div class="card-footer bg-white border-0 pb-3"><a class="btn btn-outline-dark w-100" href="<c:url value='/products/${p.id}'/>">Xem và tùy chọn</a></div></article></div></c:forEach>
<c:if test="${empty result.items}"><div class="col-12"><p class="alert alert-light border">Chưa có sản phẩm phù hợp. Hãy thử danh mục hoặc shop khác.</p></div></c:if>
</div>
