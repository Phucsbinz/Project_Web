<%@ page pageEncoding="UTF-8" %>
<div class="row g-4 product-grid"><c:forEach items="${result.items}" var="p"><div class="col-6 col-lg-3"><article class="card h-100 product-card"><div class="product-image-wrap"><c:choose><c:when test="${not empty p.imageUrl}"><img class="catalog-photo" src="<c:out value='${p.imageUrl}'/>" alt="<c:out value='${p.name}'/>" loading="lazy" width="400" height="400"></c:when><c:otherwise><div class="catalog-placeholder" aria-label="Sản phẩm chưa có ảnh"><svg class="icon" aria-hidden="true"><use href="#i-leaf"/></svg><span>UTETRA</span></div></c:otherwise></c:choose></div><div class="card-body"><p class="product-type">YOUR LITTLE TEA BREAK</p><h3><c:out value="${p.name}"/></h3><p class="product-price"><small>Từ</small><span data-money="${p.basePrice}">${p.basePrice} đ</span></p><div class="product-meta"><span>Đã bán ${p.soldUnits}</span><span>★ ${p.rating}</span><span>♡ ${p.favorites}</span></div><c:if test="${not p.available}"><span class="badge text-bg-secondary mt-2">Tạm hết món</span></c:if></div><div class="card-footer"><a class="btn btn-outline-dark w-100" href="<c:url value='/products/${p.id}'/>">Chọn món<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></div></article></div></c:forEach>
<c:if test="${empty result.items}"><div class="col-12"><div class="empty-state"><svg class="icon" aria-hidden="true"><use href="#i-leaf"/></svg><h3>Ly trà hợp gu đang chờ bạn.</h3><p>Chưa có sản phẩm phù hợp. Hãy thử danh mục hoặc shop khác.</p><a class="text-link" href="<c:url value='/stores'/>">Khám phá cửa hàng <span aria-hidden="true">↗</span></a></div></div></c:if></div>
