<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Đặt hàng</title><link rel="stylesheet" href="<c:url value='/assets/css/checkout.css'/>"></head><body>
<jsp:include page="nav.jsp"/>
<span class="eyebrow">THE LAST STEP TO A GOOD SIP</span><h1 class="h3">Xác nhận đơn hàng</h1><div id="order-message" hidden role="alert"></div>
<script src="<c:url value='/assets/js/orders.js'/>"></script>
<section class="checkout-page checkout-branch-card card card-body mb-4"><span class="eyebrow">BƯỚC 1 · CHI NHÁNH PHỤC VỤ</span><h2 class="h5">Bạn muốn chi nhánh nào chuẩn bị món?</h2><p class="text-secondary small">Chi nhánh sẽ kiểm tra món, size, topping và tồn kho. Giá cùng phí giao sẽ được xác nhận ở bước tiếp theo.</p><form id="branch-form" class="d-flex gap-3 flex-wrap"><label class="flex-grow-1">Chi nhánh<select class="form-select" name="branch" required><option value="">Chọn chi nhánh phục vụ</option><c:forEach items="${branches}" var="b"><option value="${b.id}" ${param.branch == b.id ? 'selected' : ''}><c:out value="${b.name}"/> — <c:out value="${b.address}"/></option></c:forEach></select></label><button type="submit" class="btn btn-primary align-self-end">${branchReady ? 'Đổi chi nhánh' : 'Tiếp tục'}</button></form></section>
<script>document.getElementById('branch-form').addEventListener('submit',async event=>{event.preventDefault();const form=event.currentTarget;if(!form.reportValidity())return;const button=form.querySelector('button[type=submit]');button.disabled=true;try{const cart=await orders.send('/checkout/branch',{storeId:Number(new FormData(form).get('branch')),version:${cartVersion}});sessionStorage.removeItem('utetra.checkout.key');location.href=(document.querySelector('meta[name="app-context"]')?.content||'')+'/checkout?branch='+cart.storeId;}catch(error){orders.message(error.message,true);button.disabled=false;}});</script>
<c:if test="${branchReady}"><c:if test="${groupPaymentMode == 'INDIVIDUAL'}"><p class="alert alert-info">Nếu chọn QR, mỗi người thanh toán phần tiền sau giảm và phí giao được chia. Nếu chọn COD, chủ nhóm thanh toán toàn bộ khi nhận hàng.</p></c:if><h2 class="h5">Bước 2 · Giao hàng và thanh toán</h2>
<form id="checkout-form" class="checkout-page card card-body gap-3" data-group-token="${groupToken}" data-group-mode="${groupPaymentMode}" data-store-id="${availability.storeId}">
<section class="checkout-contact"><h3 class="h6">Thông tin nhận hàng</h3><input type="hidden" name="addressId">
<div class="row g-3"><label class="col-md-6">Người nhận<input class="form-control" name="recipientName" autocomplete="name" maxlength="100" required></label><label class="col-md-6">Số điện thoại<input class="form-control" name="phone" type="tel" autocomplete="tel" maxlength="20" required></label><div class="col-12 checkout-address-entry"><label class="d-block" for="delivery-address">Địa chỉ</label><input id="delivery-address" class="form-control" name="addressDetail" autocomplete="off" maxlength="500" required role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="address-suggestions" placeholder="Nhập địa chỉ nhận hàng"><div id="address-suggestions" class="checkout-address-suggestions" role="listbox" aria-label="Gợi ý địa chỉ" hidden><c:forEach items="${choices.addresses}" var="a"><button type="button" role="option" data-address-id="${a.id}" data-recipient="<c:out value='${a.recipient_name}'/>" data-phone="<c:out value='${a.phone}'/>" data-address="<c:out value='${a.address_detail}'/>"><strong><c:out value="${a.address_detail}"/></strong><small><c:out value="${a.recipient_name}"/> · <c:out value="${a.phone}"/></small></button></c:forEach></div><small id="address-save-status" class="text-secondary" aria-live="polite">Nhập địa chỉ mới hoặc chọn gợi ý khi bấm vào ô địa chỉ.</small></div></div></section>
<div id="checkout-availability" class="small text-secondary" aria-live="polite"></div>
<label>Khu vực tính phí giao hàng<select name="areaId" class="form-select" required><option value="">Chọn khu vực</option><c:forEach items="${choices.areas}" var="a"><option value="${a.id}"><c:out value="${a.name}"/></option></c:forEach></select></label>
<label>Nhà vận chuyển<select name="carrierId" class="form-select" required><option value="">Chọn nhà vận chuyển</option><c:forEach items="${choices.carriers}" var="c"><option value="${c.id}"><c:out value="${c.name}"/></option></c:forEach></select></label>
<c:choose><c:when test="${groupDiscountActive}"><div class="checkout-group-discount"><span class="form-label d-block">Ưu đãi món</span><strong>Đã áp dụng ưu đãi nhóm</strong><small class="d-block text-secondary">Mức giảm được tính tự động trong báo giá.</small><input type="hidden" name="productPromotionId" value=""></div></c:when><c:otherwise><label>Ưu đãi món<select name="productPromotionId" class="form-select"><option value="">Không dùng</option><c:forEach items="${choices.promotions}" var="p"><c:if test="${p.kind == 'PRODUCT_PERCENT'}"><option value="${p.id}"><c:out value="${p.name}"/></option></c:if></c:forEach></select></label></c:otherwise></c:choose>
<label>Ưu đãi phí giao<select name="shippingPromotionId" class="form-select"><option value="">Không dùng</option><c:forEach items="${choices.promotions}" var="p"><c:if test="${p.kind == 'SHIPPING_PERCENT'}"><option value="${p.id}"><c:out value="${p.name}"/></option></c:if></c:forEach></select></label>
<label>Điểm sử dụng (1 điểm = 1.000đ, tối đa 20%)<input class="form-control" name="points" ${groupPaymentMode == 'INDIVIDUAL' ? 'readonly' : ''} type="number" min="0" value="0"></label>
<label>Ghi chú<textarea class="form-control" name="note" maxlength="500" rows="2" placeholder="Ví dụ: gọi trước khi giao"></textarea></label>
<fieldset class="checkout-payment-options"><legend class="h6">Phương thức thanh toán</legend><div class="d-flex flex-wrap gap-3"><label class="checkout-payment-choice"><input type="radio" name="paymentMethod" value="COD" checked> Tiền mặt · COD</label><c:if test="${bankEnabled && groupPaymentMode != 'INDIVIDUAL'}"><label class="checkout-payment-choice"><input type="radio" name="paymentMethod" value="BANK_TRANSFER"> Chuyển khoản ngân hàng · Admin đối soát</label></c:if><c:if test="${localQrEnabled}"><label class="checkout-payment-choice"><input type="radio" name="paymentMethod" value="LOCAL_QR"> Thanh toán QR</label></c:if><c:if test="${vnpayEnabled && groupPaymentMode != 'INDIVIDUAL'}"><label class="checkout-payment-choice"><input type="radio" name="paymentMethod" value="VNPAY"> VNPAY</label></c:if></div></fieldset>
<p>Với đơn nhóm chia phần, tất cả thành viên phải thanh toán xong phần mình trước khi cửa hàng xác nhận đơn.</p>
<section id="quote-detail" class="checkout-bill" aria-labelledby="bill-title" aria-busy="false" data-state="incomplete"><div class="checkout-bill-heading"><div><span class="eyebrow">KIỂM TRA TRƯỚC KHI ĐẶT</span><h3 id="bill-title" class="h5">Chi tiết thanh toán</h3></div><span id="quote-state" class="small text-secondary" role="status">Điền đủ thông tin giao hàng để tính tổng tiền</span></div><dl class="checkout-bill-lines"><div><dt>Tiền món</dt><dd data-bill="subtotal">—</dd></div><div class="bill-discount"><dt>Giảm giá món / ưu đãi nhóm</dt><dd data-bill="productDiscount">—</dd></div><div class="bill-discount"><dt>Giảm từ điểm thành viên</dt><dd data-bill="pointsDiscount">—</dd></div><div><dt>Phí giao hàng</dt><dd data-bill="shipping">—</dd></div><div class="bill-discount"><dt>Ưu đãi phí giao</dt><dd data-bill="shippingDiscount">—</dd></div><div class="checkout-bill-total"><dt>Tổng thanh toán</dt><dd data-bill="total">—</dd></div></dl><p id="quote-group-note" class="small text-secondary mb-0" hidden></p><div id="quote-error" class="alert alert-danger mt-3 mb-0" role="alert" hidden></div><button id="quote-retry" type="button" class="btn btn-outline-primary mt-3" hidden>Thử tính lại</button><small class="text-secondary d-block mt-3">Tổng tiền tự cập nhật khi bạn thay đổi thông tin. Chọn QR sẽ mở trang thanh toán sau khi đặt đơn.</small></section><button class="btn btn-primary" type="submit" id="confirm-order" disabled>Xác nhận và đặt đơn</button>

</form><script>
document.addEventListener('DOMContentLoaded',()=>{
const form = document.querySelector('#checkout-form');
const storageKey = 'utetra.checkout.key';
let key = sessionStorage.getItem(storageKey) || utetra.uuid(); sessionStorage.setItem(storageKey, key);
let quoteHash = ''; let quoteGeneration=0;
function quoteError(text){const node=document.getElementById('quote-error');node.textContent=text;node.hidden=false;node.scrollIntoView({block:'center',behavior:'smooth'});}

const addressId=form.elements.addressId,addressInput=form.elements.addressDetail;
const suggestions=document.getElementById('address-suggestions'),addressStatus=document.getElementById('address-save-status');
const contactNames=['recipientName','phone','addressDetail'];
const contactValue=()=>Object.fromEntries(contactNames.map(name=>[name,form.elements[name].value.trim()]));
let savedContact='',pendingSave=null;
for(const [name,key] of [['recipientName','recipient'],['phone','phone']]){const input=form.elements[name],list=document.createElement('datalist');list.id='checkout-history-'+name;input.setAttribute('list',list.id);const values=new Set([...suggestions.querySelectorAll('button')].map(button=>button.dataset[key]).filter(Boolean));values.forEach(value=>{const option=document.createElement('option');option.value=value;list.append(option);});input.after(list);}

function closeSuggestions(){suggestions.hidden=true;addressInput.setAttribute('aria-expanded','false');}
function showSuggestions(filter=false){const query=filter?addressInput.value.trim().toLocaleLowerCase('vi'):'';let count=0;suggestions.querySelectorAll('button').forEach(button=>{button.hidden=query&&!button.dataset.address.toLocaleLowerCase('vi').includes(query);if(!button.hidden)count++;});suggestions.hidden=!count;addressInput.setAttribute('aria-expanded',String(count>0));}
function chooseAddress(button){addressId.value=button.dataset.addressId;contactNames.forEach(name=>{form.elements[name].value=button.dataset[name==='recipientName'?'recipient':name==='addressDetail'?'address':name]||'';});savedContact=JSON.stringify(contactValue());closeSuggestions();addressStatus.textContent='Bạn có thể sửa địa chỉ hoặc thông tin người nhận.';addressInput.focus();closeSuggestions();form.dispatchEvent(new Event('input',{bubbles:true}));}
suggestions.addEventListener('click',event=>{const button=event.target.closest('button');if(button)chooseAddress(button);});
addressInput.addEventListener('focus',()=>showSuggestions());addressInput.addEventListener('click',()=>showSuggestions());
addressInput.addEventListener('input',()=>showSuggestions(true));
addressInput.addEventListener('keydown',event=>{if(event.key==='Escape')closeSuggestions();if(event.key==='ArrowDown'){event.preventDefault();showSuggestions();[...suggestions.querySelectorAll('button')].find(button=>!button.hidden)?.focus();}});
suggestions.addEventListener('keydown',event=>{const buttons=[...suggestions.querySelectorAll('button')].filter(button=>!button.hidden),index=buttons.indexOf(document.activeElement);if(['ArrowDown','ArrowUp'].includes(event.key)){event.preventDefault();buttons[(index+(event.key==='ArrowDown'?1:buttons.length-1))%buttons.length]?.focus();}if(event.key==='Escape'){addressInput.focus();closeSuggestions();}});
document.addEventListener('pointerdown',event=>{if(!event.target.closest('.checkout-address-entry'))closeSuggestions();});
form.addEventListener('focusout',()=>setTimeout(()=>{if(!document.activeElement?.closest('.checkout-address-entry'))closeSuggestions();},0));
function rememberAddress(id,value){let button=[...suggestions.querySelectorAll('button')].find(button=>button.dataset.addressId===String(id));if(!button){button=document.createElement('button');button.type='button';button.setAttribute('role','option');const title=document.createElement('strong'),detail=document.createElement('small');button.append(title,detail);suggestions.prepend(button);}button.dataset.addressId=id;button.dataset.recipient=value.recipientName;button.dataset.phone=value.phone;button.dataset.address=value.addressDetail;button.querySelector('strong').textContent=value.addressDetail;button.querySelector('small').textContent=value.recipientName+' · '+value.phone;for(const name of ['recipientName','phone']){const list=document.getElementById('checkout-history-'+name);if(![...list.options].some(option=>option.value===value[name])){const option=document.createElement('option');option.value=value[name];list.append(option);}}}
async function saveAddress(){const value=contactValue(),signature=JSON.stringify(value);if(addressId.value&&savedContact===signature)return;if(pendingSave){await pendingSave;return saveAddress();}const existing=[...suggestions.querySelectorAll('button')].find(button=>button.dataset.address===value.addressDetail&&button.dataset.recipient===value.recipientName&&button.dataset.phone===value.phone);if(existing){addressId.value=existing.dataset.addressId;savedContact=signature;return;}pendingSave=(async()=>{addressStatus.textContent='Đang lưu địa chỉ…';const saved=await orders.send('/account/addresses',{...value,isDefault:false});rememberAddress(saved.id,value);if(JSON.stringify(contactValue())===signature){addressId.value=String(saved.id);savedContact=signature;addressStatus.textContent='Đã lưu địa chỉ. Lần sau bấm vào ô địa chỉ để chọn lại.';}})();try{await pendingSave;}finally{pendingSave=null;}}
contactNames.forEach(name=>form.elements[name].addEventListener('change',()=>{if(contactNames.every(field=>form.elements[field].value.trim()&&form.elements[field].checkValidity()))saveAddress().catch(error=>{addressStatus.textContent=error.message;});}));

function payload() {const f = new FormData(form);return {key, addressId:Number(f.get('addressId')), areaId:Number(f.get('areaId')), carrierId:Number(f.get('carrierId')), productPromotionId:f.get('productPromotionId')?Number(f.get('productPromotionId')):null, shippingPromotionId:f.get('shippingPromotionId')?Number(f.get('shippingPromotionId')):null, points:Number(f.get('points')), note:f.get('note'), paymentMethod:f.get('paymentMethod'), quoteHash};}
const bill=document.getElementById('quote-detail'),billState=document.getElementById('quote-state'),confirmButton=document.getElementById('confirm-order');
const currency=new Intl.NumberFormat('vi-VN',{style:'currency',currency:'VND'});let quoteTimer,quoteBusy=false,submitting=false;
const quoteFingerprint=()=>JSON.stringify({...payload(),quoteHash:'',...contactValue()});let lastQuoteFingerprint='';
function invalidateQuote(event){const fingerprint=quoteFingerprint();if(event&&event.target!==form&&fingerprint===lastQuoteFingerprint)return;lastQuoteFingerprint=fingerprint;quoteHash='';quoteGeneration++;confirmButton.disabled=true;bill.dataset.state='incomplete';bill.querySelectorAll('[data-bill]').forEach(node=>node.textContent='—');document.getElementById('quote-group-note').hidden=true;document.getElementById('quote-error').hidden=true;document.getElementById('quote-retry').hidden=true;billState.textContent='Đang cập nhật thông tin…';clearTimeout(quoteTimer);quoteTimer=setTimeout(updateQuote,650);}
async function updateQuote(){if(submitting)return;if(quoteBusy){clearTimeout(quoteTimer);quoteTimer=setTimeout(updateQuote,250);return;}if(!form.checkValidity()){billState.textContent='Điền đủ thông tin hợp lệ để tính tổng tiền';bill.dataset.state='incomplete';return;}const generation=quoteGeneration;quoteBusy=true;bill.setAttribute('aria-busy','true');billState.textContent='Đang tính tổng thanh toán…';bill.dataset.state='loading';try{await saveAddress();if(generation!==quoteGeneration)return;const q=await orders.send('/checkout/quote',payload());if(generation!==quoteGeneration)return;quoteHash=q.hash;bill.querySelectorAll('[data-bill]').forEach(node=>{const value=Number(q[node.dataset.bill]||0);node.textContent=(node.dataset.bill.toLowerCase().includes('discount')&&value>0?'−':'')+currency.format(value);});const note=document.getElementById('quote-group-note');note.hidden=!q.group?.participants;if(!note.hidden)note.textContent='Nhóm '+q.group.participants+' người · Ưu đãi '+currency.format(q.group.discount)+' · '+(q.group.paymentMode==='HOST'?'Chủ nhóm thanh toán toàn bộ.':'Mỗi người thanh toán phần mình.');billState.textContent='Đã cập nhật · '+(payload().paymentMethod==='LOCAL_QR'?'Thanh toán QR':'Thanh toán '+(payload().paymentMethod==='COD'?'khi nhận hàng':payload().paymentMethod==='BANK_TRANSFER'?'chuyển khoản ngân hàng':'VNPAY'));bill.dataset.state='ready';lastQuoteFingerprint=quoteFingerprint();document.getElementById('quote-error').hidden=true;document.getElementById('quote-retry').hidden=true;document.getElementById('order-message').hidden=true;confirmButton.disabled=false;}catch(error){if(generation===quoteGeneration){bill.dataset.state='error';billState.textContent='Chưa tính được tổng tiền';const node=document.getElementById('quote-error');node.textContent=error.message;node.hidden=false;document.getElementById('quote-retry').hidden=false;}}finally{quoteBusy=false;bill.setAttribute('aria-busy','false');}}
for(const type of ['change','input'])form.addEventListener(type,invalidateQuote);
document.getElementById('quote-retry').addEventListener('click',()=>{invalidateQuote();});
setTimeout(invalidateQuote,0);window.addEventListener('pagehide',()=>clearTimeout(quoteTimer));
form.addEventListener('submit',async event=>{event.preventDefault();if(submitting||!quoteHash||bill.dataset.state!=='ready'||!form.reportValidity())return;submitting=true;const button=document.querySelector('#confirm-order');button.disabled=true;try {const order=await orders.send('/checkout',payload());sessionStorage.removeItem(storageKey);if(form.dataset.groupToken&&payload().paymentMethod==='COD')sessionStorage.setItem('utetra.group.placed.'+order.id,'true');location.href=(document.querySelector('meta[name="app-context"]')?.content||'')+(payload().paymentMethod==='LOCAL_QR'?'/orders/'+order.id+'/qr-payment':'/orders/'+order.id);}catch(e){submitting=false;quoteHash='';bill.dataset.state='error';billState.textContent='Chưa tạo được đơn';confirmButton.disabled=true;quoteError(e.message);document.getElementById('quote-retry').hidden=false;}});
});
</script><script src="<c:url value='/assets/js/checkout-availability.js'/>"></script></c:if><script src="<c:url value='/assets/js/checkout-fields.js'/>"></script></body></html>
