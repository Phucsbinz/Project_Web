<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Vận chuyển và hoa hồng</title></head><body>
<jsp:include page="nav.jsp"/>
<span class="eyebrow">OPERATIONS & SETTINGS</span><h1 class="h3">Vận chuyển và hoa hồng cửa hàng</h1><div id="order-message" hidden role="alert"></div>
<div class="table-responsive"><table class="table"><thead><tr><th>ID</th><th>Nhà vận chuyển</th><th>Phí cơ bản</th><th>Hoạt động</th><th>Phạm vi</th><th></th></tr></thead><tbody><c:forEach items="${carriers}" var="c"><tr><td><c:out value="${c.id}"/></td><td><c:out value="${c.name}"/></td><td><c:out value="${c.baseFee}"/></td><td><c:out value="${c.isActive}"/></td><td><c:choose><c:when test="${empty c.storeId}">Toàn hệ thống</c:when><c:otherwise>Cửa hàng #<c:out value="${c.storeId}"/></c:otherwise></c:choose></td><td><c:if test="${c.canManage}"><button class="btn btn-outline-primary edit-carrier" data-id="${c.id}" data-version="${c.version}" data-name="<c:out value='${c.name}'/>" data-fee="${c.baseFee}" data-active="${c.isActive}" data-store="${c.storeId}">Chỉnh sửa</button></c:if></td></tr></c:forEach></tbody></table></div>
<form id="carrier-form" class="card card-body gap-2 mb-3"><h2 class="h5">Tạo / cập nhật nhà vận chuyển</h2><p>Manager quản lý tên và phí nhà vận chuyển riêng của cửa hàng được giao. Danh mục dùng toàn hệ thống do Admin quản lý.</p><label>Phạm vi<select class="form-select" name="storeId"><c:if test="${admin}"><option value="">Toàn hệ thống</option></c:if><c:forEach items="${stores}" var="s"><option value="${s.id}"><c:out value="${s.name}"/></option></c:forEach></select></label><input name="id" type="hidden"><input name="version" type="hidden" value="0"><label>Tên<input class="form-control" name="name" maxlength="150" required></label><label>Phí cơ bản VND<input class="form-control" name="baseFee" type="number" min="0" required></label><label><input name="active" type="checkbox" checked> Hoạt động</label><button class="btn btn-primary">Lưu nhà vận chuyển</button></form>
<h2 class="h5">Biểu phí hiện tại</h2><div class="table-responsive"><table class="table"><thead><tr><th>Cửa hàng / khu vực</th><th>Nhà vận chuyển</th><th>Phí bổ sung</th><th>Áp dụng</th></tr></thead><tbody><c:forEach items="${rates}" var="r"><tr><td><c:out value="${r.store_name}"/> / <c:out value="${r.area_name}"/></td><td><c:out value="${r.carrier_name}"/></td><td><c:out value="${r.additional_fee}"/>đ</td><td><c:out value="${r.is_active}"/></td></tr></c:forEach></tbody></table></div><form id="rate-form" class="card card-body gap-2 mb-3"><h2 class="h5">Phí theo khu vực trong phạm vi được giao</h2><label>Nhà vận chuyển<select name="carrierId" class="form-select"><c:forEach items="${carriers}" var="c"><option value="${c.id}"><c:out value="${c.name}"/></option></c:forEach></select></label><label>Khu vực giao<select class="form-select" name="areaId" required><option value="">Chọn khu vực</option><c:forEach items="${areas}" var="a"><option value="${a.id}"><c:out value="${a.store_name}"/> — <c:out value="${a.name}"/></option></c:forEach></select></label><label>Phí bổ sung VND<input class="form-control" name="fee" type="number" min="0" required></label><label><input name="active" type="checkbox" checked> Áp dụng</label><button class="btn btn-primary">Lưu biểu phí</button></form>
<form id="commission-form" class="card card-body gap-2"><h2 class="h5">Hoa hồng áp dụng cho đơn mới</h2><label>Cửa hàng<select name="storeId" class="form-select"><c:forEach items="${stores}" var="s"><option value="${s.id}"><c:out value="${s.name}"/> (hiện tại <c:out value="${s.commission_rate}"/>%)</option></c:forEach></select></label><label>Tỷ lệ %<input class="form-control" name="percent" type="number" min="0" max="100" step="0.01" required></label><p>Đơn đã chốt giữ tỷ lệ snapshot; thay chính sách không đổi doanh thu lịch sử.</p><button class="btn btn-primary">Lưu chính sách mới</button></form>
<c:if test="${admin}"><form id="global-commission-form" class="card card-body gap-2 mt-3"><h2 class="h5">Chính sách hoa hồng toàn hệ thống</h2><label>Tỷ lệ %<input name="percent" class="form-control" type="number" min="0" max="100" step="0.01" required></label><p>Áp dụng cho các đơn mới ở mọi cửa hàng; giữ snapshot đơn cũ.</p><button class="btn btn-outline-primary">Áp dụng toàn hệ thống</button></form></c:if>
<script src="<c:url value='/assets/js/orders.js'/>"></script><script>
document.querySelectorAll('.edit-carrier').forEach(button=>button.addEventListener('click',()=>{const f=document.getElementById('carrier-form');f.elements.id.value=button.dataset.id;f.elements.storeId.value=button.dataset.store;f.elements.version.value=button.dataset.version;f.elements.name.value=button.dataset.name;f.elements.baseFee.value=button.dataset.fee;f.elements.active.checked=button.dataset.active==='true';f.scrollIntoView({behavior:'smooth'});}));
const base=location.pathname.substring((document.querySelector('meta[name="app-context"]')?.content||'').length);
for(const [id,route] of [['carrier-form','carriers'],['rate-form','rates'],['commission-form','commissions']])document.getElementById(id)?.addEventListener('submit',event=>{event.preventDefault();const data=Object.fromEntries(new FormData(event.target));for(const key of ['id','version','baseFee','carrierId','areaId','fee','storeId','percent'])if(key in data)data[key]=data[key]===''?null:Number(data[key]);if(route!=='commissions')data.active=!!event.target.elements.active.checked;orders.action(base+'/'+route,data);});
document.getElementById('global-commission-form')?.addEventListener('submit',event=>{event.preventDefault();if(confirm('Áp dụng tỷ lệ mới cho mọi cửa hàng?'))orders.action('/admin/order-tools/commissions/global',{percent:Number(new FormData(event.target).get('percent'))});});
</script></body></html>
