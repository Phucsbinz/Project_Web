<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Chi tiết đơn hàng</title></head><body>
<jsp:include page="nav.jsp"/>
<h1 class="h3 text-break">Đơn <c:out value="${order.code}"/></h1><div id="order-message" hidden role="alert"></div>
<c:if test="${mode == 'buyer' && order.groupOrder}"><p class="alert alert-info">Đơn nhóm · ${order.owner ? 'Bạn là chủ nhóm.' : 'Bạn đang theo dõi đơn với vai trò thành viên. Chủ nhóm quản lý hủy đơn và xác nhận nhận hàng.'} <a class="text-link" href="<c:url value='/group-orders/${order.groupToken}'/>">Xem nhóm</a></p></c:if>
<p>Trạng thái: <strong><span class="status-pill" data-status="${order.status}"><c:out value="${order.status}"/></span></strong> · Thanh toán: <span class="status-pill" data-status="${order.paymentStatus}"><c:out value="${order.paymentStatus}"/></span> · Tổng: <span data-money="${order.total}"><c:out value="${order.total}"/></span></p>
<c:if test="${shipperEnabled && order.status == 'CONFIRMED'}"><section class="card card-body mb-3" id="dispatch-summary"><h2 class="h5">Phân công giao hàng</h2><c:choose><c:when test="${order.dispatchStatus == 'ASSIGNED'}"><p class="mb-0">Đã phân công Shipper <strong><c:out value="${order.delivery[0].name}"/></strong>. Cửa hàng sẽ bàn giao món khi chuẩn bị xong.</p></c:when><c:otherwise><p class="mb-0 text-warning-emphasis">Đơn đã xác nhận, đang chờ Shipper phù hợp trong phạm vi chi nhánh. Không có Shipper hoạt động để phân công lúc này.</p><c:if test="${mode == 'operator'}"><button type="button" class="btn btn-outline-primary mt-3 align-self-start" id="retry-dispatch">Thử phân công tự động</button></c:if></c:otherwise></c:choose></section></c:if>
<c:if test="${mode == 'buyer'}"><p class="mb-3"><a class="btn btn-outline-primary" href="<c:url value='/orders/${order.id}/invoice'/>">Xem hóa đơn</a></p></c:if>
<c:if test="${mode != 'shipper' && order.paymentMethod == 'LOCAL_QR' && order.paymentStatus != 'PAID'}"><section class="card card-body mb-3"><h2 class="h5">Thanh toán QR</h2><p>Đơn chỉ được xác nhận khi đủ mọi phần thanh toán.</p><c:if test="${order.status == 'CANCELLED' || order.paymentStatus == 'REFUNDED'}"><dl class="row mb-0"><dt class="col-sm-6">Đã thanh toán trong hệ thống</dt><dd class="col-sm-6" data-money="${order.qrCollected}"></dd><dt class="col-sm-6">Chờ hoàn</dt><dd class="col-sm-6" data-money="${order.qrRefundDue}"></dd><dt class="col-sm-6">Đã hoàn</dt><dd class="col-sm-6" data-money="${order.qrRefunded}"></dd></dl><p class="small text-secondary">Chỉ hoàn phần đã thanh toán. Người chưa thanh toán không phát sinh khoản phải trả. Đây là giao dịch nội bộ, không tự chuyển tiền ngân hàng.</p></c:if><c:if test="${mode == 'buyer' && order.qrPayer && order.status == 'NEW' && order.paymentStatus == 'UNPAID' && order.myPaymentStatus != 'SUCCESS'}"><a class="btn btn-primary" href="<c:url value='/orders/${order.id}/qr-payment'/>">Thanh toán phần của tôi</a></c:if></section></c:if><c:if test="${mode != 'shipper' && order.paymentMethod == 'VNPAY'}"><section class="card card-body mb-3"><h2 class="h5">Thanh toán VNPAY</h2><c:if test="${order.paymentStatus == 'REVIEW'}"><p class="alert alert-warning">Giao dịch đang chờ đối soát cổng. Không chuyển hoặc thanh toán lại; liên hệ Admin kiểm tra với merchant.</p></c:if><p>Đơn chỉ được xác nhận thanh toán sau khi hệ thống nhận IPN hợp lệ từ cổng. Trở về từ cổng không tự xác nhận đã trả tiền.</p><c:if test="${mode == 'buyer' && order.owner && order.status == 'NEW' && order.paymentStatus == 'UNPAID'}"><button class="btn btn-primary" id="pay-vnpay">Tiếp tục đến VNPAY</button></c:if><c:if test="${order.paymentStatus == 'FAILED'}"><p>Giao dịch không thành công. Hãy hủy đơn chờ và kiểm tra trạng thái trước khi đặt lại.</p></c:if></section></c:if>
<c:if test="${mode != 'shipper' && order.paymentMethod == 'BANK_TRANSFER' && (mode != 'buyer' || order.owner)}">
<section class="card card-body mb-3 order-bank-payment" aria-labelledby="bank-title">
<h2 id="bank-title" class="h5">Chuyển khoản ngân hàng</h2>
<p><c:out value="${bank.bank}"/> · Chủ tài khoản: <strong><c:out value="${bank.owner}"/></strong> · Số tài khoản: <strong><c:out value="${bank.account}"/></strong></p>
<c:if test="${mode == 'buyer' && order.owner && order.status == 'NEW' && order.paymentStatus == 'UNPAID'}">
<div class="row g-3 align-items-start"><div class="col-sm-5 col-lg-3"><img class="img-fluid rounded" src="<c:url value='${bank.qrPath}'/>" alt="QR tài khoản nhận tiền Techcombank BUI THANH PHUC" width="1080" height="1920"></div>
<div class="col-sm-7 col-lg-9"><p>Số tiền cần chuyển: <strong><span data-money="${order.total}"><c:out value="${order.total}"/></span></strong></p>
<p>Nội dung chuyển khoản: <strong><c:out value="${bank.memo}"/></strong></p>
<p>QR chỉ chứa tài khoản nhận. Nhập đúng số tiền và nội dung ở trên trong ứng dụng ngân hàng; kiểm tra tên người nhận trước khi chuyển.</p>
<p class="alert alert-info">Đang chờ đối soát. Sau khi chuyển, Admin sẽ xác nhận khi thấy tiền trong tài khoản. Không chuyển lại chỉ vì trạng thái chưa cập nhật.</p></div></div>
</c:if>
<c:if test="${order.status == 'CANCELLED' || order.paymentStatus == 'REFUND_PENDING'}"><p class="alert alert-warning">Đơn đã hủy: không chuyển thêm tiền. Nếu đã chuyển, liên hệ quản trị với mã giao dịch để đối soát và hoàn tiền.</p></c:if>
<c:if test="${role == 'ROLE_ADMIN' && (order.status == 'NEW' && order.paymentStatus == 'UNPAID' || order.status == 'CANCELLED' && order.paymentStatus == 'CANCELLED')}">
<form id="bank-confirm-form" class="d-grid gap-2"><p>Đối soát sao kê với nội dung <strong><c:out value="${bank.memo}"/></strong>. Chỉ xác nhận sau khi tiền thực sự vào tài khoản; tiền đến sau khi hủy sẽ chờ hoàn.</p>
<label>Mã giao dịch trên sao kê<input id="bank-reference" class="form-control" required minlength="3" maxlength="100" pattern="[A-Za-z0-9][A-Za-z0-9._/-]{2,99}"></label>
<label>Số tiền thực nhận (VND)<input id="bank-amount" class="form-control" required type="number" min="1" step="1"></label>
<button class="btn btn-success" type="submit">Xác nhận đã nhận chuyển khoản</button></form>
</c:if>
</section></c:if>
<c:if test="${mode == 'shipper'}"><p class="alert alert-info text-break">Địa chỉ lấy hàng hiện tại: <c:out value="${order.pickupAddress}"/> · Điện thoại cửa hàng: <c:out value="${order.pickupPhone}"/></p></c:if>
<div class="card card-body mb-3"><p>Cửa hàng: <c:out value="${order.storeName}"/></p><p>Người nhận: <c:out value="${order.recipientName}"/> — <c:out value="${order.recipientPhone}"/></p><p>Địa chỉ: <c:out value="${order.deliveryAddress}"/></p><p>Vận chuyển: <c:out value="${order.carrierName}"/></p><p>Ghi chú: <c:out value="${order.note}"/></p></div>
<c:if test="${not empty order.delivery}"><section class="card card-body mb-3" aria-label="Thông tin giao hàng"><h2 class="h5">Phân công giao hàng</h2><c:forEach items="${order.delivery}" var="d"><p>Shipper: <strong><c:out value="${d.name}"/></strong> · Phân công lúc <time data-timestamp="${d.assignedAt}"><c:out value="${d.assignedAt}"/></time></p><c:if test="${mode == 'shipper'}"><p class="alert alert-info">${order.paymentMethod == 'COD' && order.paymentStatus != 'PAID' ? 'Đơn COD: chỉ xác nhận giao thành công sau khi đã thu đủ tiền.' : 'Không thu thêm tiền khi đơn đã thanh toán.'}</p><c:if test="${not order.canShip}"><p class="text-secondary">Đơn đang chờ cửa hàng xác nhận hoặc đã kết thúc. Không có thao tác giao hàng ở trạng thái này.</p></c:if><details class="text-break"><summary>Nhật ký giao hàng</summary><ul class="mt-2"><c:forEach items="${d.events}" var="e"><li><span data-status="${e.type}"><c:out value="${e.type}"/></span> · <time data-timestamp="${e.createdAt}"><c:out value="${e.createdAt}"/></time> <c:out value="${e.note}"/></li></c:forEach></ul></details></c:if></c:forEach></section></c:if>
<div class="table-responsive"><table class="table"><thead><tr><th>Món</th><th>Size / tùy chọn</th><th>Số ly</th><th>Thành tiền</th></tr></thead><tbody><c:forEach items="${order.items}" var="i"><tr><td><c:out value="${i.name}"/><small class="d-block"><c:forEach items="${i.toppings}" var="top"><span class="me-2"><c:out value="${top.name}"/></span></c:forEach></small></td><td><c:out value="${i.size}"/> · Đường <c:out value="${i.sugar}"/>% · Đá <c:out value="${i.ice}"/>%<c:forEach items="${i.toppings}" var="t"><div><c:out value="${t.name}"/></div></c:forEach><small><c:out value="${i.note}"/></small></td><td><c:out value="${i.quantity}"/></td><td><c:out value="${i.total}"/>đ</td></tr></c:forEach></tbody></table></div>
<c:if test="${mode == 'operator' || mode == 'buyer' && order.owner || mode == 'shipper' && order.canShip}"><section class="card card-body gap-2 mb-3"><h2 class="h5">Thao tác</h2>
<c:if test="${(mode == 'operator' && order.status == 'NEW' || mode == 'shipper' && order.canShip) && (order.paymentMethod == 'COD' || order.paymentStatus == 'PAID') && order.status != 'DELIVERED' && order.status != 'CANCELLED' && order.status != 'REFUNDED' && order.status != 'RETURN_REQUESTED' && order.status != 'RETURN_APPROVED' && order.status != 'RETURNED'}"><label>Bước tiếp theo<select id="next-status" class="form-select"><c:choose><c:when test="${order.status == 'NEW'}"><option>CONFIRMED</option></c:when><c:when test="${order.status == 'CONFIRMED'}"><option>PICKED_UP</option></c:when><c:when test="${order.status == 'PICKED_UP'}"><option>DELIVERING</option></c:when><c:when test="${order.status == 'DELIVERING'}"><option>DELIVERED</option></c:when></c:choose></select></label>
<c:if test="${mode == 'shipper' && order.status == 'DELIVERING' && order.paymentMethod == 'COD'}"><label><input id="cash-collected" type="checkbox"> Đã thu đủ tiền COD khi giao</label></c:if><button class="btn btn-primary" id="transition">Cập nhật trạng thái</button></c:if>
<c:if test="${mode != 'shipper' && (order.status == 'NEW' || mode == 'operator' && (order.status == 'CONFIRMED' || order.status == 'PICKED_UP' || order.status == 'DELIVERING'))}"><label>Lý do hủy<input class="form-control" id="cancel-reason" maxlength="500"></label><button class="btn btn-outline-danger" id="cancel">Hủy đơn</button></c:if>
<c:if test="${mode == 'buyer' && order.owner && order.status == 'DELIVERED' && empty order.returns}"><label>Lý do trả hàng trong 3 tiếng<textarea class="form-control" id="return-reason" maxlength="2000"></textarea></label><label>Ảnh chứng cứ (tùy chọn, JPEG/PNG tối đa 5 MB)<input class="form-control" type="file" id="return-image" accept="image/jpeg,image/png"></label><button class="btn btn-outline-primary" id="request-return">Yêu cầu trả hàng, hoàn cả đơn</button></c:if>
<c:if test="${mode == 'operator' && order.status == 'RETURN_REQUESTED'}"><label>Lý do quyết định<textarea class="form-control" id="decision-reason" maxlength="1000"></textarea></label><label><input type="checkbox" id="waive"> Cho phép miễn trả vật lý đối với đồ uống lỗi</label><button class="btn btn-success" id="approve">Duyệt yêu cầu</button><button class="btn btn-outline-danger" id="reject">Từ chối có lý do</button></c:if>
<c:if test="${mode == 'operator' && order.status == 'RETURN_APPROVED'}"><button class="btn btn-primary" id="receive-return">Xác nhận đã nhận hàng trả</button></c:if>
<c:if test="${mode == 'operator' && (order.status == 'RETURN_APPROVED' || order.status == 'RETURNED' || order.status == 'CANCELLED' && order.paymentStatus == 'REFUND_PENDING') && (order.paymentMethod == 'COD' || role == 'ROLE_ADMIN')}"><label>${order.paymentMethod == 'LOCAL_QR' ? 'Tham chiếu xử lý hoàn nội bộ' : 'Tham chiếu chứng cứ đã hoàn tiền thực tế'}<input class="form-control" id="refund-evidence" maxlength="500"></label><p>${order.paymentMethod == 'LOCAL_QR' ? 'Xác nhận sau khi đã xử lý hoàn đúng các phần thanh toán trong hệ thống. Không chuyển tiền ngân hàng.' : 'Chỉ xác nhận sau khi tiền đã thực sự trả lại khách. Miễn trả vật lý phải được duyệt trước.'}</p><button class="btn btn-success" id="refund">${order.paymentMethod == 'LOCAL_QR' ? 'Xác nhận đã hoàn phần đã thanh toán' : 'Xác nhận đã hoàn cả đơn'}</button></c:if>
<c:if test="${shipperEnabled && mode == 'operator' && (role == 'ROLE_ADMIN' || role == 'ROLE_MANAGER') && order.status == 'CONFIRMED'}"><label for="shipper-id">Shipper nhận giao<select class="form-select" id="shipper-id"><option value="">Chọn Shipper hoạt động</option><c:forEach items="${shippers}" var="s"><option value="${s.id}" ${not empty order.delivery && order.delivery[0].shipperId == s.id ? 'selected' : ''}><c:out value="${s.full_name}"/> · #<c:out value="${s.id}"/></option></c:forEach></select></label><c:if test="${empty shippers}"><p class="text-secondary">Chưa có Shipper hoạt động được cấp phạm vi chi nhánh này. Admin cần cấp phạm vi phục vụ trước khi phân công.</p></c:if><label for="assignment-reason">Lý do phân công / đổi Shipper<input class="form-control" id="assignment-reason" maxlength="500"></label><button class="btn btn-outline-secondary" id="assign" ${empty shippers ? 'disabled' : ''}>Phân công / đổi Shipper</button></c:if>
<c:if test="${mode == 'shipper' && (order.status == 'PICKED_UP' || order.status == 'DELIVERING')}"><label>Lý do giao thất bại<input class="form-control" id="failure-reason" maxlength="500"></label><button class="btn btn-outline-danger" id="failure">Báo giao thất bại</button></c:if>
</section></c:if>
<c:forEach items="${order.returns}" var="r"><div class="alert alert-info">Yêu cầu trả: <c:out value="${r.reason}"/>; quyết định: <c:out value="${r.decisionReason}"/>; trạng thái: <span class="status-pill" data-status="${r.status}"><c:out value="${r.status}"/></span><c:if test="${not empty r.evidenceUrl}"><a href="<c:out value='${r.evidenceUrl}'/>" target="_blank" rel="noopener noreferrer">Xem ảnh chứng cứ</a></c:if></div></c:forEach>
<c:if test="${mode == 'buyer' && order.owner}"><c:choose><c:when test="${order.received}"><p class="alert alert-success">Bạn đã xác nhận nhận hàng lúc <c:out value="${order.receivedAt}"/>.</p></c:when><c:when test="${order.status == 'DELIVERED' && order.paymentStatus == 'PAID'}"><button type="button" id="confirm-received" class="btn btn-primary mb-3">Đã nhận hàng</button></c:when></c:choose></c:if>
<h2 class="h5">Lịch sử</h2><ul class="list-group mb-4"><c:forEach items="${order.history}" var="h"><li class="list-group-item text-break"><c:out value="${h.createdAt}"/> · <c:out value="${h.type}"/> · <span class="status-pill" data-status="${h.status}"><c:out value="${h.status}"/></span> · <c:out value="${h.reason}"/></li></c:forEach></ul>
<script src="<c:url value='/assets/js/orders.js'/>"></script><script>
const base = '${base}/${order.id}'; const version = ${order.version};
const on=(id,fn)=>document.getElementById(id)?.addEventListener('click',fn);
document.getElementById('bank-confirm-form')?.addEventListener('submit',event=>{event.preventDefault();orders.action(base+'/bank-confirmation',{reference:document.getElementById('bank-reference').value,amount:Number(document.getElementById('bank-amount').value),version});});
on('confirm-received',async()=>{if(await window.utetraConfirm('Bạn đã nhận đủ món của đơn hàng này?','Xác nhận đã nhận hàng'))orders.action(base+'/received',{});});
on('pay-vnpay',async()=>{try {const result=await orders.send('/orders/${order.id}/vnpay',{});location.href=result.url;}catch(e){orders.message(e.message,true);}});
on('transition',async()=>{const status=document.getElementById('next-status').value;const terminal='${mode}'==='shipper'&&status==='DELIVERED';const result=await orders.action(base+'/status',{status,version,reason:'',cashCollected:(document.getElementById('cash-collected')?.checked || false)},!terminal);if(terminal&&result)location.href="<c:url value='/shipper/orders'/>?status=DELIVERED";});
on('cancel',async()=>{const groupOrder=${order.groupOrder == true};if(!await window.utetraConfirm(groupOrder?'Bạn có chắc muốn hủy đơn nhóm?\nThành viên sẽ nhận thông báo nhóm đã hủy. Phần đã thanh toán (nếu có) dự kiến được hoàn sau 30 phút.':'Bạn có chắc muốn hủy đơn hàng này?',groupOrder?'Xác nhận hủy đơn nhóm':'Xác nhận hủy đơn','Xác nhận hủy'))return;orders.action(base+'/cancel',{status:'CANCELLED',version,reason:document.getElementById('cancel-reason').value,cashCollected:false});});
on('request-return',()=>{const image=document.getElementById('return-image').files[0];const reason=document.getElementById('return-reason').value.trim();if(!reason){orders.message('Vui lòng nhập lý do trả hàng.',true);return;}if(image){if(!['image/jpeg','image/png'].includes(image.type)||image.size>5*1024*1024){orders.message('Chọn ảnh JPEG/PNG tối đa 5 MB.',true);return;}const form=new FormData();form.set('reason',reason);form.set('image',image);orders.action(base+'/returns/evidence',form);}else orders.action(base+'/returns',{reason});});
for(const id of ['approve','reject'])on(id,()=>orders.action(base+'/returns/review',{approve:id==='approve',waivePhysicalReturn:document.getElementById('waive').checked,reason:document.getElementById('decision-reason').value,version}));
on('receive-return',()=>orders.action(base+'/returns/receive',{version}));
on('refund',()=>orders.action(base+'/refund',{evidence:document.getElementById('refund-evidence').value,version}));
on('failure',()=>orders.action(base+'/failure',{status:'DELIVERY_FAILED',version,reason:document.getElementById('failure-reason').value,cashCollected:false}));
on('retry-dispatch',()=>orders.action(base+'/auto-assignment',{version}));
on('assign',()=>{const shipperId=Number(document.getElementById('shipper-id').value);if(!Number.isSafeInteger(shipperId)||shipperId<=0){orders.message('Vui lòng chọn Shipper hoạt động.',true);return;}orders.action(base+'/assignment',{shipperId,version,reason:document.getElementById('assignment-reason').value});});
if('${mode}'==='buyer'&&sessionStorage.getItem('utetra.group.placed.${order.id}')){sessionStorage.removeItem('utetra.group.placed.${order.id}');setTimeout(()=>window.utetraConfirm('Đặt đơn nhóm thành công. Chủ nhóm thanh toán toàn bộ khi nhận hàng. Vui lòng để ý điện thoại để cửa hàng liên hệ xác nhận và giao hàng.','Đặt đơn nhóm thành công'),600);}
// Poll authoritative state when no realtime subscription is available.
let polling=setInterval(async()=>{try{const r=await fetch((document.querySelector('meta[name="app-context"]')?.content||'')+base+'/data',{headers:{Accept:'application/json'},cache:'no-store'});if(r.status===401||r.status===403){clearInterval(polling);orders.message('Phiên hoặc quyền truy cập đã thay đổi. Vui lòng đăng nhập lại.',true);return;}if(r.ok){const current=await r.json();if(current.version!==version){if('${mode}'==='buyer'&&!window.utetraDialogBusy&&!document.querySelector('.modal.show')&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName)){location.reload();return;}orders.message('Đơn đã thay đổi. Tải lại để xem trạng thái mới.');}}}catch(e){}},15000);
</script></body></html>
