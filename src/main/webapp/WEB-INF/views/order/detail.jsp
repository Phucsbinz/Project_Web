<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Chi tiết đơn hàng</title></head><body>
<jsp:include page="nav.jsp"/>
<h1 class="h3 text-break">Đơn <c:out value="${order.code}"/></h1><div id="order-message" hidden role="alert"></div>
<p>Trạng thái: <strong><span class="status-pill" data-status="${order.status}"><c:out value="${order.status}"/></span></strong> · Thanh toán: <span class="status-pill" data-status="${order.paymentStatus}"><c:out value="${order.paymentStatus}"/></span> · Tổng: <span data-money="${order.total}"><c:out value="${order.total}"/>đ</span></p>
<div class="card card-body mb-3"><p>Cửa hàng: <c:out value="${order.storeName}"/></p><p>Người nhận: <c:out value="${order.recipientName}"/> — <c:out value="${order.recipientPhone}"/></p><p>Địa chỉ: <c:out value="${order.deliveryAddress}"/></p><p>Vận chuyển: <c:out value="${order.carrierName}"/></p><p>Ghi chú: <c:out value="${order.note}"/></p></div>
<div class="table-responsive"><table class="table"><thead><tr><th>Món</th><th>Size / tùy chọn</th><th>Số ly</th><th>Thành tiền</th></tr></thead><tbody><c:forEach items="${order.items}" var="i"><tr><td><c:out value="${i.name}"/><small class="d-block"><c:forEach items="${i.toppings}" var="top"><span class="me-2"><c:out value="${top.name}"/></span></c:forEach></small></td><td><c:out value="${i.size}"/> · Đường <c:out value="${i.sugar}"/>% · Đá <c:out value="${i.ice}"/>%<c:forEach items="${i.toppings}" var="t"><div><c:out value="${t.name}"/></div></c:forEach><small><c:out value="${i.note}"/></small></td><td><c:out value="${i.quantity}"/></td><td><c:out value="${i.total}"/>đ</td></tr></c:forEach></tbody></table></div>
<section class="card card-body gap-2 mb-3"><h2 class="h5">Thao tác</h2>
<c:if test="${mode != 'buyer' && order.status != 'DELIVERED' && order.status != 'CANCELLED' && order.status != 'REFUNDED' && order.status != 'RETURN_REQUESTED' && order.status != 'RETURN_APPROVED' && order.status != 'RETURNED'}"><label>Bước tiếp theo<select id="next-status" class="form-select"><c:choose><c:when test="${order.status == 'NEW'}"><option>CONFIRMED</option></c:when><c:when test="${order.status == 'CONFIRMED'}"><option>PICKED_UP</option></c:when><c:when test="${order.status == 'PICKED_UP'}"><option>DELIVERING</option></c:when><c:when test="${order.status == 'DELIVERING'}"><option>DELIVERED</option></c:when></c:choose></select></label><label><input id="cash-collected" type="checkbox"> Đã thu đủ tiền COD khi giao</label><button class="btn btn-primary" id="transition">Cập nhật trạng thái</button></c:if>
<c:if test="${mode != 'shipper' && (order.status == 'NEW' || mode == 'operator' && (order.status == 'CONFIRMED' || order.status == 'PICKED_UP' || order.status == 'DELIVERING'))}"><label>Lý do hủy<input class="form-control" id="cancel-reason" maxlength="500"></label><button class="btn btn-outline-danger" id="cancel">Hủy đơn</button></c:if>
<c:if test="${mode == 'buyer' && order.status == 'DELIVERED' && empty order.returns}"><label>Lý do trả hàng trong 3 tiếng<textarea class="form-control" id="return-reason" maxlength="2000"></textarea></label><label>Ảnh chứng cứ (tùy chọn, JPEG/PNG tối đa 5 MB)<input class="form-control" type="file" id="return-image" accept="image/jpeg,image/png"></label><button class="btn btn-outline-primary" id="request-return">Yêu cầu trả hàng, hoàn cả đơn</button></c:if>
<c:if test="${mode == 'operator' && order.status == 'RETURN_REQUESTED'}"><label>Lý do quyết định<textarea class="form-control" id="decision-reason" maxlength="1000"></textarea></label><label><input type="checkbox" id="waive"> Cho phép miễn trả vật lý đối với đồ uống lỗi</label><button class="btn btn-success" id="approve">Duyệt yêu cầu</button><button class="btn btn-outline-danger" id="reject">Từ chối có lý do</button></c:if>
<c:if test="${mode == 'operator' && order.status == 'RETURN_APPROVED'}"><button class="btn btn-primary" id="receive-return">Xác nhận đã nhận hàng trả</button></c:if>
<c:if test="${mode == 'operator' && (order.status == 'RETURN_APPROVED' || order.status == 'RETURNED')}"><label>Tham chiếu chứng cứ đã hoàn tiền COD<input class="form-control" id="refund-evidence" maxlength="500"></label><p>Chỉ xác nhận sau khi tiền đã thực sự trả lại khách. Miễn trả vật lý phải được duyệt trước.</p><button class="btn btn-success" id="refund">Xác nhận đã hoàn cả đơn</button></c:if>
<c:if test="${shipperEnabled && mode == 'operator' && (order.status == 'NEW' || order.status == 'CONFIRMED' || order.status == 'PICKED_UP' || order.status == 'DELIVERING')}"><label>Mã Shipper hoạt động<input class="form-control" id="shipper-id" type="number" min="1"></label><button class="btn btn-outline-secondary" id="assign">Phân công / đổi Shipper</button></c:if>
<c:if test="${mode == 'shipper' && (order.status == 'PICKED_UP' || order.status == 'DELIVERING')}"><label>Lý do giao thất bại<input class="form-control" id="failure-reason" maxlength="500"></label><button class="btn btn-outline-danger" id="failure">Báo giao thất bại</button></c:if>
</section>
<c:forEach items="${order.returns}" var="r"><div class="alert alert-info">Yêu cầu trả: <c:out value="${r.reason}"/>; quyết định: <c:out value="${r.decisionReason}"/>; trạng thái: <span class="status-pill" data-status="${r.status}"><c:out value="${r.status}"/></span><c:if test="${not empty r.evidenceUrl}"><a href="<c:out value='${r.evidenceUrl}'/>" target="_blank" rel="noopener noreferrer">Xem ảnh chứng cứ</a></c:if></div></c:forEach>
<h2 class="h5">Lịch sử</h2><ul class="list-group mb-4"><c:forEach items="${order.history}" var="h"><li class="list-group-item"><c:out value="${h.createdAt}"/> · <c:out value="${h.type}"/> · <span class="status-pill" data-status="${h.status}"><c:out value="${h.status}"/></span> · <c:out value="${h.reason}"/></li></c:forEach></ul>
<script src="<c:url value='/assets/js/orders.js'/>"></script><script>
const base = '${base}/${order.id}'; const version = ${order.version};
const on=(id,fn)=>document.getElementById(id)?.addEventListener('click',fn);
on('transition',()=>orders.action(base+'/status',{status:document.getElementById('next-status').value,version,reason:'',cashCollected:document.getElementById('cash-collected').checked}));
on('cancel',()=>orders.action(base+'/cancel',{status:'CANCELLED',version,reason:document.getElementById('cancel-reason').value,cashCollected:false}));
on('request-return',()=>{const image=document.getElementById('return-image').files[0];const reason=document.getElementById('return-reason').value;if(image){const form=new FormData();form.set('reason',reason);form.set('image',image);orders.action(base+'/returns/evidence',form);}else orders.action(base+'/returns',{reason});});
for(const id of ['approve','reject'])on(id,()=>orders.action(base+'/returns/review',{approve:id==='approve',waivePhysicalReturn:document.getElementById('waive').checked,reason:document.getElementById('decision-reason').value,version}));
on('receive-return',()=>orders.action(base+'/returns/receive',{version}));
on('refund',()=>orders.action(base+'/refund',{evidence:document.getElementById('refund-evidence').value,version}));
on('failure',()=>orders.action(base+'/failure',{status:'DELIVERY_FAILED',version,reason:document.getElementById('failure-reason').value,cashCollected:false}));
on('assign',()=>orders.action(base+'/assignment',{shipperId:Number(document.getElementById('shipper-id').value),version}));
// Poll authoritative state when no realtime subscription is available.
let polling=setInterval(async()=>{try{const r=await fetch((document.querySelector('meta[name="app-context"]')?.content||'')+base+'/data');if(r.status===401||r.status===403){clearInterval(polling);return;}if(r.ok){const current=await r.json();if(current.version!==version){clearInterval(polling);orders.message('Đơn đã thay đổi. Tải lại để xem trạng thái mới.');}}}catch(e){}},15000);
</script></body></html>
