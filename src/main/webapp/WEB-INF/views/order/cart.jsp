<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Giỏ hàng · UTETra</title><link rel="stylesheet" href="<c:url value='/assets/css/cart.css'/>"></head><body>
<jsp:include page="nav.jsp"/>
<section class="cart-page" data-version="${cart.version}" data-expires-at="${cart.expiresAt}" data-server-now="${cart.serverNow}"><div class="order-page-head"><span class="eyebrow">CHỌN VỊ NGON · GÓI NIỀM VUI</span><h1>Giỏ hàng của bạn.</h1><p>Kiểm tra món yêu thích, chọn chi nhánh ở bước thanh toán.</p></div><p class="cart-expiry" role="status">Giỏ được giữ 1 giờ kể từ lần cập nhật gần nhất. <strong data-cart-countdown></strong></p><div id="order-message" hidden role="alert"></div>
<c:choose><c:when test="${empty cart.items}"><div class="empty-state cart-empty"><svg class="icon" aria-hidden="true"><use href="#i-bag"/></svg><h2>Giỏ nhỏ, đợi niềm vui lớn.</h2><p>Chọn ly trà yêu thích để bắt đầu nhé.</p><a class="btn btn-primary" href="<c:url value='/menu'/>">Khám phá thực đơn →</a></div></c:when><c:otherwise>
<c:if test="${cart.groupOrderId > 0}"><div class="alert alert-info">Giỏ nhóm đã chốt. Các món được giữ cố định đến khi thanh toán; mở nhóm bên dưới để hủy nếu muốn chỉnh sửa.</div></c:if><div class="cart-layout"><div class="cart-lines"><div class="cart-section-heading"><label class="cart-select-all"><input type="checkbox" id="select-all" ${cart.groupOrderId > 0 ? 'disabled' : ''}> Chọn tất cả (${cart.items.size()} món)</label><button class="btn btn-link text-danger" id="clear-cart" ${cart.groupOrderId > 0 ? 'disabled' : ''}>Xóa tất cả</button></div>
<c:forEach items="${cart.items}" var="item"><article class="cart-line" data-subtotal="${item.subtotal}"><input type="checkbox" class="cart-item-select form-check-input" ${cart.groupOrderId > 0 ? 'disabled' : ''} data-id="${item.id}" ${item.selected ? 'checked' : ''} aria-label="Chọn <c:out value='${item.name}'/>"><div class="cart-line-photo"><c:if test="${not empty item.imageUrl}"><img src="<c:out value='${item.imageUrl}'/>" alt="<c:out value='${item.name}'/>" width="112" height="112"></c:if></div><div class="cart-line-info"><h3><c:out value="${item.name}"/></h3><p>Size <c:out value="${item.size}"/> · ${item.sugar}% đường · ${item.ice}% đá</p><c:if test="${not empty item.toppings}"><p><c:forEach items="${item.toppings}" var="top"><span class="cart-option"><c:out value="${top}"/></span></c:forEach></p></c:if><c:if test="${not empty item.note}"><p class="cart-note">Ghi chú: <c:out value="${item.note}"/></p></c:if><span class="cart-unit-price" data-money="${item.unitPrice}"></span></div><div class="cart-line-actions"><strong data-money="${item.subtotal}"></strong><div class="cart-stepper"><button type="button" ${cart.groupOrderId > 0 ? 'disabled' : ''} data-step="-1" aria-label="Giảm số ly">−</button><input aria-label="Số ly" class="quantity" ${cart.groupOrderId > 0 ? 'disabled' : ''} type="number" min="1" max="20" value="${item.quantity}" data-id="${item.id}"><button type="button" ${cart.groupOrderId > 0 ? 'disabled' : ''} data-step="1" aria-label="Tăng số ly">+</button></div><button class="btn btn-link text-danger delete-item" ${cart.groupOrderId > 0 ? 'disabled' : ''} data-id="${item.id}">Xóa</button></div></article></c:forEach>
<a class="text-link cart-more" href="<c:url value='/menu'/>">← Chọn thêm món</a></div>
<aside class="cart-summary"><span class="eyebrow">SẴN SÀNG CHO MỘT NGÀY VUI</span><h2>Tóm tắt giỏ hàng</h2><div><span>Tạm tính (<span data-selected-count></span> món được chọn)</span><strong data-cart-selected-total data-money="${subtotal}"></strong></div><div><span>Phí giao hàng</span><span>Tính khi lên đơn</span></div><div class="cart-total"><span>Tiền món tạm tính</span><strong data-cart-selected-total data-money="${subtotal}"></strong></div><p>Giá và ưu đãi sẽ được xác nhận sau khi chọn chi nhánh. Chưa bao gồm phí giao hàng.</p><c:choose><c:when test="${signedIn}"><a class="btn btn-primary w-100" id="cart-checkout" href="<c:url value='/checkout'/>">Tiếp tục thanh toán →</a></c:when><c:otherwise><a class="btn btn-primary w-100" href="<c:url value='/auth/login'/>">Đăng nhập để đặt hàng</a></c:otherwise></c:choose><small>Size, đường đá và topping được giữ theo lựa chọn của bạn.</small></aside></div>
</c:otherwise></c:choose>
<div class="cart-group-invite"><div><span class="eyebrow">CÙNG ĐẶT · CÙNG VUI</span><h2>Một nhóm bạn, nhiều vị ngon.</h2><p>Tạo nhóm và mời bạn bè tham gia trước. Mỗi người chọn món rồi chủ nhóm đặt.</p><div class="group-tiers"><span><b>3 người</b> giảm 5%</span><span><b>5 người</b> giảm 10%</span><span><b>10 người</b> giảm 15%</span></div><small>Tối đa 100.000đ/đơn · Chỉ tính người đã gửi món · Không cộng dồn mã giảm sản phẩm.</small></div><div><c:choose><c:when test="${signedIn}"><label class="form-label" for="group-payment-mode">Cách thanh toán</label><select id="group-payment-mode" class="form-select mb-2"><option value="HOST">Chủ nhóm thanh toán toàn bộ</option><option value="INDIVIDUAL">Mỗi người tự thanh toán phần mình</option></select><button id="create-group" class="btn btn-primary">Tạo đơn nhóm</button><c:forEach items="${groups}" var="group"><a class="btn btn-outline-dark d-block mt-2" href="<c:url value='/group-orders/${group.token}'/>"><c:out value="${group.code}"/> · <c:out value="${group.hostName}"/><small class="d-block"><c:out value="${group.statusLabel}"/> · ${group.memberCount} thành viên</small></a></c:forEach></c:when><c:otherwise><a class="btn btn-primary" href="<c:url value='/auth/login'/>">Đăng nhập để tạo nhóm</a></c:otherwise></c:choose></div></div>
<c:if test="${signedIn}"><div class="cart-merge"><button class="btn btn-outline-secondary" id="merge-cart">Nhập món đã chọn trước khi đăng nhập</button><small>Chỉ dùng khi bạn đã chọn món trước lúc đăng nhập.</small></div></c:if>
</section><script src="<c:url value='/assets/js/orders.js'/>"></script><script src="<c:url value='/assets/js/cart.js'/>"></script></body></html>
