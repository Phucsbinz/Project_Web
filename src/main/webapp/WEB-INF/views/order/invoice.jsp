<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Hóa đơn · UTETra</title><link rel="stylesheet" href="<c:url value='/assets/css/invoice.css'/>"></head><body>
<section class="invoice-page" data-order-id="${order.id}" data-viewer-id="${viewerId}" data-owner="${order.owner}"><div class="invoice-heading"><div><span class="eyebrow">UTETRA · THÔNG TIN ĐƠN HÀNG</span><h1>Hóa đơn chi tiết</h1><p>Mã đơn <strong><c:out value="${order.code}"/></strong></p><p class="small text-secondary">Đặt lúc <time><c:out value="${order.createdAt}"/></time></p></div><button type="button" class="btn btn-outline-primary" id="invoice-print">In / lưu PDF</button></div>
<div id="invoice-progress" class="alert alert-info" role="status"></div>
<div class="invoice-grid"><div><section class="card card-body"><h2 class="h5">Thông tin giao hàng</h2><dl><dt>Người nhận</dt><dd><c:out value="${order.recipientName}"/></dd><dt>Số điện thoại</dt><dd><c:out value="${order.recipientPhone}"/></dd><dt>Địa chỉ</dt><dd><c:out value="${order.deliveryAddress}"/></dd><dt>Khu vực giao</dt><dd><c:out value="${order.deliveryAreaName}"/></dd><dt>Nhà vận chuyển</dt><dd><c:out value="${order.carrierName}"/></dd><dt>Ghi chú</dt><dd><c:out value="${empty order.note ? 'Không có' : order.note}"/></dd></dl></section>
<section class="card card-body mt-3"><h2 class="h5">Món đã đặt · <c:out value="${order.storeName}"/></h2><c:forEach items="${order.items}" var="item"><article class="invoice-item"><div><strong>${item.quantity} × <c:out value="${item.name}"/></strong><small class="d-block">Size <c:out value="${item.size}"/> · ${item.sugar}% đường · ${item.ice}% đá<c:forEach items="${item.toppings}" var="top"> · <c:out value="${top.name}"/></c:forEach></small><small><c:out value="${item.note}"/></small></div><strong data-money="${item.total}"></strong></article></c:forEach></section></div>
<aside class="card card-body"><h2 class="h5">Chi tiết thanh toán</h2><dl class="invoice-totals"><div><dt>Tiền món</dt><dd data-money="${order.subtotal}"></dd></div><div><dt>Giảm món / ưu đãi nhóm</dt><dd data-money="${order.productDiscount}"></dd></div><div><dt>Giảm điểm thành viên</dt><dd data-money="${order.pointsDiscount}"></dd></div><div><dt>Phí giao</dt><dd data-money="${order.shippingGross}"></dd></div><div><dt>Ưu đãi phí giao</dt><dd data-money="${order.shippingDiscount}"></dd></div><div class="invoice-total"><dt>Tổng đơn</dt><dd data-money="${order.total}"></dd></div></dl><p class="small">Điểm đã dùng: ${order.pointsUsed}</p><c:forEach items="${order.appliedVouchers}" var="voucher"><p class="small">Ưu đãi: <c:out value="${voucher.name}"/> · <span data-money="${voucher.discount}"></span></p></c:forEach><c:if test="${order.groupOrder && order.paymentMethod == 'LOCAL_QR'}"><c:choose><c:when test="${order.myPaymentStatus == 'HOST'}"><p>Bạn không có khoản thanh toán riêng cho đơn này.</p></c:when><c:otherwise><p>Phần thanh toán của bạn: <strong data-money="${order.myShare}"></strong></p></c:otherwise></c:choose><small>Đây là hóa đơn chung của nhóm; phần thanh toán được phân bổ theo lựa chọn của chủ nhóm.</small></c:if><p class="mt-3">Hình thức: ${order.paymentMethod == 'COD' ? 'Thanh toán khi nhận hàng' : order.paymentMethod == 'LOCAL_QR' ? 'Thanh toán QR' : order.paymentMethod}</p><p>Đơn hàng: <span id="invoice-order-state" data-status="${order.status}"><c:out value="${order.status}"/></span></p><p>Thanh toán: <span id="invoice-payment-state" data-status="${order.paymentStatus}"><c:out value="${order.paymentStatus}"/></span></p></aside></div>
<nav class="invoice-actions" aria-label="Sau đặt hàng"><a class="btn btn-primary" href="<c:url value='/orders'/>">Đơn đã mua</a><a class="btn btn-outline-primary" href="<c:url value='/'/>">Về trang chủ</a><a class="btn btn-outline-primary" href="<c:url value='/orders/${order.id}'/>">Theo dõi đơn</a><c:if test="${order.groupOrder}"><a class="btn btn-outline-primary" href="<c:url value='/group-orders/${order.groupToken}'/>">Xem nhóm</a></c:if></nav><p class="small text-secondary">Cảm ơn bạn đã lựa chọn UTETra.</p></section><script src="<c:url value='/assets/js/invoice.js'/>"></script></body></html>
