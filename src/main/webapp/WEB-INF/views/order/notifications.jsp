<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Thông báo đơn hàng</title></head><body>
<jsp:include page="nav.jsp"/>
<h1 class="h3">Thông báo</h1><div id="order-message" hidden role="alert"></div><c:if test="${empty notifications}"><div class="alert alert-info">Chưa có thông báo.</div></c:if><ul class="list-group"><c:forEach items="${notifications}" var="n"><li class="list-group-item"><strong><c:out value="${n.title}"/></strong><p><c:out value="${n.content}"/></p><small><c:out value="${n.createdAt}"/></small><c:if test="${!n.read}"><button class="btn btn-sm btn-outline-primary read-notification" data-id="${n.id}">Đánh dấu đã đọc</button></c:if></li></c:forEach></ul><script src="<c:url value='/assets/js/orders.js'/>"></script><script>document.querySelectorAll('.read-notification').forEach(node=>node.addEventListener('click',()=>orders.action('/notifications/'+node.dataset.id+'/read',{})));</script></body></html>
