<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Đặt đơn nhóm · UTETra</title><link rel="stylesheet" href="<c:url value='/assets/css/cart.css'/>"></head><body><jsp:include page="nav.jsp"/>
<section class="group-page" data-token="<c:out value='${group.token}'/>" data-version="${group.version}" data-status="${group.status}"><span class="eyebrow">CÙNG CHỌN · CÙNG VUI</span><h1>Đặt đơn nhóm <span class="group-summary-code"><c:out value="${group.code}"/></span></h1><p>Tham gia nhóm → Chọn món cho mình → Chủ nhóm đặt đơn.</p><div id="order-message" hidden role="alert"></div>
<div class="group-layout"><div class="group-members"><h2>${group.memberCount} thành viên · ${group.participants} người đã có món</h2><p class="group-state"><c:choose><c:when test="${group.expired || group.status == 'EXPIRED'}">Nhóm đã hết hạn</c:when><c:when test="${group.status == 'OPEN'}">Đang chọn món · Link có hiệu lực 24 giờ</c:when><c:when test="${group.status == 'SPLIT_READY'}">Đã chốt · Mỗi người thanh toán phần của mình</c:when><c:when test="${group.status == 'LOCKED'}">Đã chốt · Chủ nhóm thanh toán chung</c:when><c:when test="${group.status == 'ORDERED'}">Đã tạo đơn hàng</c:when><c:otherwise>Nhóm đã hủy</c:otherwise></c:choose></p>
<c:forEach items="${group.members}" var="member"><div class="group-member-block"><div class="group-member"><span class="group-avatar" aria-hidden="true">☘</span><div><strong><c:out value="${member.name}"/></strong><c:if test="${member.host}"><span class="badge text-bg-success ms-2">Chủ nhóm</span></c:if><c:if test="${member.me}"><span class="badge text-bg-light">Bạn</span></c:if><p>${member.cups} ly</p></div><span class="group-ready">${member.ordered ? 'Đã tạo đơn' : member.confirmed ? 'Đã có món ✓' : 'Đang chọn món'}</span></div><div class="group-selection"><c:forEach items="${member.items}" var="item"><div class="group-selection-line"><c:if test="${not empty item.imageUrl}"><img src="<c:out value='${item.imageUrl}'/>" alt="" width="48" height="48"></c:if><div><strong>${item.quantity} × <c:out value="${item.name}"/></strong><small>Size <c:out value="${item.size}"/> · ${item.sugar}% đường · ${item.ice}% đá<c:forEach items="${item.toppings}" var="top"> · <c:out value="${top}"/></c:forEach></small><c:if test="${member.me && group.status == 'OPEN' && !group.expired}"><button class="btn btn-link text-danger p-0" data-group-remove="${item.configuration}">Xóa món</button></c:if></div><span data-money="${item.subtotal}"></span></div></c:forEach><c:if test="${member.ordered}"><div class="group-estimate"><div><span>Tiền món</span><strong data-money="${member.billedSubtotal}"></strong></div><div><span>Giảm giá phần của bạn</span><strong data-money="${member.discount}"></strong></div><div><span>Phí giao được chia</span><strong data-money="${member.shippingShare}"></strong></div><div><span>${group.paymentMode == 'INDIVIDUAL' ? 'Phần tiền cần thanh toán' : 'Phần tiền chủ nhóm thanh toán'}</span><strong data-money="${member.amountDue}"></strong></div></div></c:if><c:if test="${member.me && member.ordered && group.status == 'ORDERED'}"><a class="btn btn-primary mt-3" href="<c:url value='/group-orders/${group.token}/payment'/>">Xem thanh toán của tôi</a></c:if><c:if test="${empty member.items}"><small>Chưa chọn món.</small></c:if></div></div></c:forEach>
<c:if test="${group.status == 'OPEN' && !group.expired}"><div class="group-share"><label for="group-link">Link mời tham gia nhóm</label><input id="group-link" class="form-control" readonly><button class="btn btn-outline-dark" id="copy-group-link">Sao chép link</button><small>Mở link và tham gia nhóm trước, sau đó chọn món của bạn ngay trong nhóm.</small></div></c:if></div>
<aside class="group-benefit"><span class="eyebrow">ƯU ĐÃI NHÓM</span><h2>Giảm ${group.percent}% tiền món</h2><p><strong>${group.paymentMode == 'INDIVIDUAL' ? 'Mỗi người trả phần mình' : 'Chủ nhóm thanh toán toàn bộ'}</strong></p><div class="group-estimate"><div><span>Tạm tính cả nhóm</span><strong data-money="${group.subtotal}"></strong></div><div><span>Ưu đãi dự kiến</span><strong data-money="${group.estimatedDiscount}"></strong></div></div><div class="group-tiers"><span><b>3 người</b>5%</span><span><b>5 người</b>10%</span><span><b>10 người</b>15%</span></div><p>Chỉ tính người đã chọn món; tối đa 100.000đ cho cả nhóm. Không cộng dồn mã giảm món. Phí giao tính khi thanh toán.</p>
<c:if test="${group.status == 'OPEN' && !group.expired && group.host}"><label class="form-label" for="group-payment-mode">Chủ nhóm chọn cách trả tiền</label><select id="group-payment-mode" class="form-select"><option value="HOST" ${group.paymentMode == 'HOST' ? 'selected' : ''}>Chủ nhóm trả toàn bộ</option><option value="INDIVIDUAL" ${group.paymentMode == 'INDIVIDUAL' ? 'selected' : ''}>Mỗi người trả phần mình</option></select><small class="d-block mb-3">Lựa chọn được lưu khi chủ nhóm đổi cách trả.</small></c:if><c:if test="${group.status == 'OPEN' && !group.expired}"><c:choose><c:when test="${!group.joined}"><button class="btn btn-primary w-100" data-group-action="join">Tham gia nhóm</button></c:when><c:otherwise><a class="btn btn-primary w-100" href="<c:url value='/menu'/>?group=${group.token}">Chọn món cho tôi</a><c:if test="${!group.host}"><button class="btn btn-outline-danger mt-2" data-group-action="leave">Rời nhóm</button></c:if></c:otherwise></c:choose><c:if test="${group.host}"><button class="btn btn-dark w-100 mt-3" data-group-action="lock">Chốt nhóm và thanh toán</button><small>Tiếp tục đến trang thanh toán để chọn chi nhánh và điền địa chỉ giao hàng. Không cần chờ thành viên xác nhận. Tổng tối đa 50 ly.</small></c:if></c:if>
<c:if test="${group.status == 'LOCKED' && group.host && !group.expired}"><a class="btn btn-primary w-100" href="<c:url value='/checkout'/>">Tiếp tục thanh toán</a></c:if><c:if test="${group.canCancel}"><button class="btn btn-outline-danger mt-3" data-group-action="cancel">Hủy nhóm</button></c:if><a class="text-link d-block mt-3" href="<c:url value='/cart'/>">Về giỏ hàng</a></aside></div></section>
<script src="<c:url value='/assets/js/orders.js'/>"></script><script src="<c:url value='/assets/js/cart.js'/>"></script></body></html>