<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Báo cáo doanh thu</title></head><body>
<jsp:include page="nav.jsp"/>
<span class="eyebrow">YOUR BUSINESS AT A GLANCE</span><h1 class="h3">Báo cáo doanh thu</h1><form method="get" class="d-flex flex-wrap gap-3 mb-3"><label>Từ ngày<input class="form-control" name="from" type="date" value="${report.from}" required></label><label>Đến ngày<input class="form-control" name="to" type="date" value="${report.to}" required></label><label>Cửa hàng<select class="form-select" name="store"><option value="">Tất cả trong phạm vi</option><c:forEach items="${stores}" var="s"><option value="${s.id}"><c:out value="${s.name}"/></option></c:forEach></select></label><button class="btn btn-primary align-self-end">Xem báo cáo</button></form>
<p>Ngày theo Asia/Ho_Chi_Minh; bán ghi theo ngày giao, khoản hoàn theo ngày hoàn thành thực tế.</p><section class="report-metrics" aria-label="Tổng quan kinh doanh"><article><span>Đơn giao thành công</span><strong><c:out value="${report.orders}"/></strong></article><article><span>Doanh thu hàng hóa sau giảm</span><strong data-money="${report.goods}"><c:out value="${report.goods}"/> đ</strong></article><article><span>Hoa hồng nền tảng</span><strong data-money="${report.commission}"><c:out value="${report.commission}"/> đ</strong></article><article><span>Tiền hoàn thành công</span><strong data-money="${report.refund}"><c:out value="${report.refund}"/> đ</strong></article></section><figure class="report-chart"><figcaption>So sánh các khoản trong kỳ</figcaption><c:set var="chartScale" value="${report.goods + report.shipping + report.commission}"/><div class="report-chart-row"><span>Hàng hóa sau giảm</span><div><i style="width:${chartScale > 0 ? report.goods / chartScale * 100 : 0}%"></i></div><strong data-money="${report.goods}"><c:out value="${report.goods}"/> đ</strong></div><div class="report-chart-row"><span>Phí giao hàng</span><div><i style="width:${chartScale > 0 ? report.shipping / chartScale * 100 : 0}%"></i></div><strong data-money="${report.shipping}"><c:out value="${report.shipping}"/> đ</strong></div><div class="report-chart-row"><span>Hoa hồng nền tảng</span><div><i style="width:${chartScale > 0 ? report.commission / chartScale * 100 : 0}%"></i></div><strong data-money="${report.commission}"><c:out value="${report.commission}"/> đ</strong></div></figure><h2 class="h5">Chi tiết doanh thu trong kỳ</h2><dl class="row report-breakdown"><dt class="col-sm-6">Số đơn giao</dt><dd class="col-sm-6"><c:out value="${report.orders}"/></dd><dt class="col-sm-6">Hàng hóa sau giảm</dt><dd class="col-sm-6" data-money="${report.goods}"><c:out value="${report.goods}"/>đ</dd><dt class="col-sm-6">Phí giao sau giảm</dt><dd class="col-sm-6" data-money="${report.shipping}"><c:out value="${report.shipping}"/>đ</dd><dt class="col-sm-6">Hoa hồng app</dt><dd class="col-sm-6" data-money="${report.commission}"><c:out value="${report.commission}"/>đ</dd><dt class="col-sm-6">Tiền hoàn thành công</dt><dd class="col-sm-6" data-money="${report.refund}"><c:out value="${report.refund}"/>đ</dd><dt class="col-sm-6">Hoa hồng thu hồi</dt><dd class="col-sm-6" data-money="${report.commissionReversed}"><c:out value="${report.commissionReversed}"/>đ</dd><dt class="col-sm-6">Net hàng hóa của shop</dt><dd class="col-sm-6" data-money="${report.storeNet}"><c:out value="${report.storeNet}"/>đ</dd></dl>
<button class="btn btn-outline-primary" id="export">Tải CSV</button><script>document.getElementById('export').addEventListener('click',()=>{const fields=new URLSearchParams(new FormData(document.querySelector('form')));location.href=location.pathname+'.csv?'+fields;});</script></body></html>
