<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Kiểm duyệt nội dung · UTETra</title><script defer src="<c:url value='/assets/js/moderation.js'/>"></script></head><body>
<section class="moderation-page" id="moderation"><h1 class="h3">Kiểm duyệt nội dung</h1><p class="text-secondary">Ẩn hoặc khôi phục đánh giá và bình luận. Nội dung, tác giả và bằng chứng mua hàng được giữ nguyên.</p>
<div id="moderation-message" class="alert alert-info" role="status" aria-live="polite">Đang tải…</div>
<form id="moderation-search" class="card card-body mb-4"><div class="row g-3"><div class="col-md-3"><label for="moderation-kind" class="form-label">Loại nội dung</label><select id="moderation-kind" name="kind" class="form-select"><option value="reviews">Đánh giá</option><option value="comments">Bình luận</option></select></div><div class="col-md-3"><label for="moderation-status" class="form-label">Hiển thị</label><select id="moderation-status" name="status" class="form-select"><option value="">Tất cả</option><option value="VISIBLE">Đang hiển thị</option><option value="HIDDEN">Đã ẩn</option></select></div><div class="col-md-4"><label for="moderation-q" class="form-label">Nội dung, tác giả hoặc sản phẩm</label><input id="moderation-q" name="q" class="form-control" maxlength="100"></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-success">Tìm kiếm</button></div></div></form>
<div id="moderation-list" class="d-grid gap-3" aria-live="polite"></div><div class="d-flex align-items-center gap-3 mt-4"><button id="moderation-prev" class="btn btn-outline-secondary" type="button">Trang trước</button><span id="moderation-page"></span><button id="moderation-next" class="btn btn-outline-secondary" type="button">Trang sau</button></div>
</section></body></html>
