<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Tổng quan kinh doanh · UTETra</title><link rel="stylesheet" href="<c:url value='/assets/css/role-workspace.css'/>"></head><body>
<section class="role-workspace"><p class="eyebrow">CHỦ CỬA HÀNG</p><h1>Tổng quan kinh doanh</h1><p>Tất cả cửa hàng do bạn sở hữu. Đơn mua cá nhân nằm trong khu vực mua hàng.</p>
<div class="d-flex flex-wrap gap-2 mb-4"><a class="btn btn-outline-primary" href="<c:url value='/menu'/>">Chuyển sang mua hàng</a><a class="btn btn-primary" href="<c:url value='/account/shop-registration'/>">Đăng ký thêm cửa hàng</a></div>
<c:choose><c:when test="${empty branches}"><div class="card card-body"><h2 class="h4">Bạn chưa có cửa hàng</h2><p>Đăng ký cửa hàng để bắt đầu kinh doanh; hồ sơ sẽ được quản trị viên xét duyệt.</p><a href="<c:url value='/account/shop-registration'/>">Đăng ký cửa hàng</a></div></c:when><c:otherwise>
<form method="get" class="d-flex flex-wrap gap-3 align-items-end mb-4"><label>Từ ngày<input name="from" type="date" class="form-control" value="${report.from}" required></label><label>Đến ngày<input name="to" type="date" class="form-control" value="${report.to}" required></label><button class="btn btn-primary">Xem số liệu</button></form>
<div class="workspace-metrics"><article><span>Cửa hàng sở hữu</span><strong><c:out value="${branches.size()}"/></strong></article><article><span>Đơn giao thành công</span><strong><c:out value="${report.orders}"/></strong></article><article><span>Hàng hóa sau giảm</span><strong data-money="${report.goods}"><c:out value="${report.goods}"/> ₫</strong></article><article><span>Thực nhận hàng hóa</span><strong data-money="${report.storeNet}"><c:out value="${report.storeNet}"/> ₫</strong></article></div>
<h2 class="h4 mt-4">So sánh cửa hàng</h2><p class="small text-secondary">Ngày Việt Nam; bán ghi theo ngày giao, hoàn theo ngày hoàn thành. Thực nhận hàng hóa = hàng hóa sau giảm − hoàn hàng hóa − (hoa hồng − hoa hồng thu hồi), không cộng phí giao.</p>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Cửa hàng</th><th>Trạng thái</th><th>Đơn giao</th><th>Hàng hóa sau giảm</th><th>Thực nhận hàng hóa</th><th>Thao tác</th><th>Manager được phân công</th></tr></thead><tbody><c:forEach items="${branches}" var="branch"><tr><td><strong><c:out value="${branch.name}"/></strong></td><td><c:choose><c:when test="${branch.status == 'ACTIVE'}">Đang hoạt động</c:when><c:when test="${branch.status == 'PENDING_APPROVAL'}">Chờ duyệt</c:when><c:when test="${branch.status == 'SUSPENDED'}">Tạm khóa</c:when><c:when test="${branch.status == 'REJECTED'}">Đã từ chối</c:when><c:otherwise><c:out value="${branch.status}"/></c:otherwise></c:choose></td><td><c:out value="${branch.report.orders}"/></td><td data-money="${branch.report.goods}"><c:out value="${branch.report.goods}"/> ₫</td><td data-money="${branch.report.storeNet}"><c:out value="${branch.report.storeNet}"/> ₫</td><td><c:url var="storeUrl" value="/vendor/shop"><c:param name="store" value="${branch.id}"/></c:url><c:url var="reportUrl" value="/vendor/revenue"><c:param name="store" value="${branch.id}"/><c:param name="from" value="${report.from}"/><c:param name="to" value="${report.to}"/></c:url><a href="${storeUrl}">Quản lý</a> · <a href="${reportUrl}">Doanh thu</a></td><td><button type="button" class="btn btn-outline-primary btn-sm" data-branch-managers="${branch.id}">Xem Manager</button><div class="small mt-2" data-manager-list="${branch.id}" aria-live="polite"></div></td></tr></c:forEach></tbody></table></div>
</c:otherwise></c:choose></section><script src="<c:url value='/assets/js/vendor-overview.js'/>" defer></script></body></html>
